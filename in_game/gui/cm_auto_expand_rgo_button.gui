types cm_auto_expand {
	# used for the location window in location_window.gui
	type cm_auto_expand_rgo_widget_location_window = cm_auto_expand_rgo_widget {
		parentanchor = bottom|right
		# Flush against each other:
		# size = { 19 19 }
		# position = { -2 -1 }
		# Medium separated:
		size = { 18 18 }
		position = { -2 -1 }
		# Smaller separated:
		# size = { 16 16 }
		# position = { -2 -1 }
	}

	type cm_auto_expand_rgo_widget_expand_raw_goods_lateralview = button_square_checkbox {
		datacontext = "[Location]"
		size = { 20 20 }
		background = {
			texture = "gfx/interface/buttons/cm_glow_square.dds"
			texture_density = 2
			glow = {
				name = "green_glow"
				glow_radius = 5
				color = { 0.0 1.0 0.0 0.9 }
				alpha = 0.6
				block "green_glow_visible" { visible = "[And(Not(GetScriptedGui('cm_location_auto_food_supersedes_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)), And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)))]" }
			}
		}
		background = {
			texture = "gfx/interface/buttons/cm_glow_square.dds"
			texture_density = 2
			glow = {
				name = "red_glow"
				glow_radius = 5
				color = { 1.0 0.0 0.0 0.9 }
				alpha = 0.6
				block "red_glow_visible" { visible = "[And(Not(GetScriptedGui('cm_location_auto_food_supersedes_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)), And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))))]" }
			}
		}
		background = {
			texture = "gfx/interface/buttons/checkbox_bg_square.dds"
			texture_density = 2
			modify_texture = { using = color_black_texture blend_mode = multiply }
		}
		parentanchor = center
		widgetanchor = center
		enabled = "[Not(GetScriptedGui('cm_location_auto_food_supersedes_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
		tooltipwidget = { using = cm_RGO_Autoexpand_Tooltip }
		blockoverride "check_texture" {
			texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
		}
		blockoverride "checked_visible" {
			visible = "[GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
		}
		blockoverride "unchecked_visible" {
			visible = "[Not(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
		}
		action_tooltip = {
			click_type = left
			click_mode = single
			click_modifier = default
			title = "CM_AUTO_EXPAND_TOGGLE"
			on_action = "[GetScriptedGui('cm_set_auto_expand_for_rgo').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
		}
		action_tooltip = {
			click_type = left
			click_mode = single
			click_modifier = shift
			title = "CM_AUTO_EXPAND_RGO_SHIFT_TOGGLE"
			description = "CM_AUTO_EXPAND_RGO_SHIFT_TOGGLE_DESC"
			on_action = "[PdxGuiTriggerAllAnimations('cm_shift_click_mass_toggle_filtered_rgos')]"
		}
		using = cm_rightclick_open_settings_window
	}

	type cm_auto_expand_rgo_widget = widget {
		visible = "[ObjectsEqual(Location.GetOwner, GetPlayer)]"
		size = { 20 20 }

		button_square_checkbox = {
			size = { 100% 100% }
			background = {
				texture = "gfx/interface/buttons/cm_glow_square.dds"
				texture_density = 2
				glow = {
					name = "green_glow"
					glow_radius = 5
					color = { 0.0 1.0 0.0 0.9 }
					alpha = 0.6
					block "green_glow_visible" { visible = "[And(Not(GetScriptedGui('cm_location_auto_food_supersedes_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)), And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)))]" }
				}
			}
			background = {
				texture = "gfx/interface/buttons/cm_glow_square.dds"
				texture_density = 2
				glow = {
					name = "red_glow"
					glow_radius = 5
					color = { 1.0 0.0 0.0 0.9 }
					alpha = 0.6
					block "red_glow_visible" { visible = "[And(Not(GetScriptedGui('cm_location_auto_food_supersedes_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)), And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))))]" }
				}
			}
			background = {
				texture = "gfx/interface/buttons/checkbox_bg_square.dds"
				texture_density = 2
				modify_texture = { using = color_black_texture blend_mode = multiply }
			}
			parentanchor = center
			widgetanchor = center
			enabled = "[And(ObjectsEqual(Location.GetOwner, GetPlayer), Not(GetScriptedGui('cm_location_auto_food_supersedes_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)))]"
			tooltipwidget = {
				using = cm_RGO_Autoexpand_Tooltip
			}

			blockoverride "check_texture" {
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
			}
			blockoverride "checked_visible" {
				visible = "[GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
			}
			blockoverride "unchecked_visible" {
				visible = "[Not(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
			}

			action_tooltip = {
				click_type = left
				click_mode = single
				click_modifier = default
				title = "CM_AUTO_EXPAND_TOGGLE"
				on_action = "[GetScriptedGui('cm_set_auto_expand_for_rgo').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
			}
			action_tooltip = {
				click_type = left
				click_mode = single
				click_modifier = shift
				title = "CM_AUTO_EXPAND_RGO_SHIFT_TOGGLE"
				description = "CM_AUTO_EXPAND_RGO_SHIFT_TOGGLE_DESC"
				on_action = "[PdxGuiTriggerAllAnimations('cm_shift_click_mass_toggle_filtered_rgos')]"
			}
			using = cm_rightclick_open_settings_window
		}
	}

	type cm_mass_auto_expand_rgo_button = hbox {
		name = "cm_parent_of_auto_expand_active_rgos"

		# Hidden datamodels drive the shift-click filtered mass toggle on the standard
		# RGO auto-expand buttons named cm_auto_expand_rgo_widget. The shift handler calls
		# PdxGuiTriggerAllAnimations with the state name below; each visible item's
		# on_finish then flips its own RGO auto-expand. set_off is derived from
		# comparing active-vs-possible CountVisibleChildren so the toggle turns
		# everything off when they're all on, otherwise on.
		vbox = {
			size = { 0 0 }
			scissor = yes
			ignore_layout = yes
			name = "cm_auto_expand_active_rgos"
			datamodel = "[ExpandRawGoodsLateralView.GetRawGoodLocationItems]"
			item = {
				overlappingitembox = {
					datacontext = "[RawGoodLocationItem.GetLocation]"
					ignore_layout = yes
					visible = "[GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
				}
			}
		}

		vbox = {
			size = { 0 0 }
			scissor = yes
			ignore_layout = yes
			name = "cm_auto_expand_possible_rgos"
			datamodel = "[ExpandRawGoodsLateralView.GetRawGoodLocationItems]"
			item = {
				overlappingitembox = {
					datacontext = "[RawGoodLocationItem.GetLocation]"
					ignore_layout = yes
					visible = "[ObjectsEqual(Location.GetOwner, GetPlayer)]"
					state = {
						name = "cm_shift_click_mass_toggle_filtered_rgos"
						on_finish = "[GetScriptedGui('cm_set_auto_expand_for_rgo').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_set_off', MakeScopeBool(GreaterThanOrEqualTo_int32(PdxGuiWidget.FindParent('cm_parent_of_auto_expand_active_rgos').FindChild('cm_auto_expand_active_rgos').CountVisibleChildren, PdxGuiWidget.AccessParent.CountVisibleChildren))).End)]"
					}
				}
			}
		}

		button_square_checkbox = {
			size = { 20 20 }
			tooltipwidget = { using = cm_Mass_Autoexpand_RGO_Tooltip }
			blockoverride "check_texture" {
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
			}
			blockoverride "checked_visible" {
				visible = "[GetScriptedGui('cm_toggle_mass_auto_expand_rgo').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			blockoverride "unchecked_visible" {
				visible = "[Not(GetScriptedGui('cm_toggle_mass_auto_expand_rgo').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			}
			onclick = "[GetScriptedGui('cm_toggle_mass_auto_expand_rgo').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			using = cm_rightclick_open_settings_window
		}
	}
}

template cm_RGO_Autoexpand_Tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			cm_auto_expand_checkbutton = {
				using = tooltip_title_icon_size
				tooltip_enabled = no
				checked = "[GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
				enabled = yes
			}
		}

		blockoverride "title_text" {
			text = "CM_AUTO_EXPAND_RGO_TT_TITLE"
		}

		blockoverride "concept_link" {
			text = [resource_gathering_operations|e]
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[GetScriptedGui('cm_location_auto_food_supersedes_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_RGO_AUTO_FOOD_ACTIVE"
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_red_texture
					}
				}
			}
			TooltipTextBlock = {
				visible = "[And(Not(GetScriptedGui('cm_location_auto_food_supersedes_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)), GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_ALL_REQUIREMENTS_MET"
				}
			}
			TooltipListBase = {
				visible = "[Not(GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"
				blockoverride "block_title" {
					text = "CM_AUTO_EXPAND_REQ_HEADER"
				}
				TooltipListRowContent = {
					cm_tooltip_row = {
						visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "first_element" { visible = yes }
						blockoverride "not_first_element" { visible = no }
						blockoverride "yes_visible" {
							visible = "[Not(GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "no_visible" {
							visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_NOT_PAUSED"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_auto_expand_rgos_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_auto_expand_rgos_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_auto_expand_rgos_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_RGO_ENABLED"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_rgo_advance_researched').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_rgo_advance_researched').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_rgo_advance_researched').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_RGO_RESEARCHED"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_rgo_not_max_level_already').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_rgo_not_max_level_already').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_rgo_not_max_level_already').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_RGO_NOT_MAX"
						}
					}
					cm_tooltip_row = {
