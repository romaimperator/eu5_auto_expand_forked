						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_RGO_ROI_PROFIT"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_rgo_under_construction').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_rgo_under_construction').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_rgo_under_construction').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_RGO_NOT_CONSTRUCTING"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_there_enough_gold_available').IsShown(GuiScope.AddScope('cm_location', Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_there_enough_gold_available').IsShown(GuiScope.AddScope('cm_location', Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_there_enough_gold_available').IsShown(GuiScope.AddScope('cm_location', Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_RGO_GOLD"
						}
					}
					cm_tooltip_row = {
						visible = "[EqualTo_CFixedPoint(GuiScope.AddScope('cm_location', Location.MakeScope).ScriptValue('cm_rgo_lumber_disp_block'), '(CFixedPoint)1')]"
						blockoverride "yes_visible" {
							visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)1')]"
						}
						blockoverride "no_visible" {
							visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_RGO_MARKET_GOODS_LUMBER"
						}
					}
					cm_tooltip_row = {
						visible = "[EqualTo_CFixedPoint(GuiScope.AddScope('cm_location', Location.MakeScope).ScriptValue('cm_rgo_masonry_disp_block'), '(CFixedPoint)1')]"
						blockoverride "yes_visible" {
							visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)1')]"
						}
						blockoverride "no_visible" {
							visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_RGO_MARKET_GOODS_MASONRY"
						}
					}
				}
			}

			CMTooltipTextBlockContainer = {
				visible = "[And(Not(GetScriptedGui('cm_location_auto_food_supersedes_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)), And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)))]"

				blockoverride "text_content" {
					CMTooltipTextBox = {
						blockoverride "text" {
							text = "CM_AUTO_EXPAND_RGO_WILL_EXPAND"
						}
					}
					CMTooltipTextBox = {
						blockoverride "text" {
							text = "CM_AUTO_EXPAND_RGO_WILL_EXPAND_COSTS"
						}
					}
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_light_green_texture
					}
				}
			}

			TooltipTextBlock = {
				visible = "[And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)))]"
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_RGO_WILL_NOT_EXPAND"
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_red_texture
					}
				}
			}
		}

		blockoverride "tooltip_ui_action_block" {
			TooltipFunctionalBlock = {
				using = tooltip_left_right_click_template
				blockoverride "action_left_text" {
					text = "[UIAction.GetLeftClickName]"
				}
				blockoverride "action_right_text" {
					text = "CM_OPEN_SETTINGS"
				}
			}
			TooltipTextBlock = {
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_RGO_SHIFT_HINT"
				}
			}
		}
	}
}

template cm_Mass_Autoexpand_RGO_Tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			cm_auto_expand_checkbutton = {
				using = tooltip_title_icon_size
				tooltip_enabled = no
				checked = "[GetScriptedGui('cm_toggle_mass_auto_expand_rgo').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				enabled = yes
			}
		}

		blockoverride "title_text" {
			text = "CM_MASS_AUTO_EXPAND_RGO_TT_TITLE"
		}

		blockoverride "concept_link" {
			text = [resource_gathering_operations|e]
		}

		blockoverride "tooltip_content" {
			TooltipListBase = {
				blockoverride "block_title" {
					text = "CM_MASS_AUTO_EXPAND_RGO_TT_DESC"
				}
			}
		}

		blockoverride "tooltip_ui_action_block" {
			TooltipFunctionalBlock = {
				using = tooltip_left_right_click_template
				blockoverride "action_left_text" {
					text = "CM_AUTO_EXPAND_TOGGLE"
				}
				blockoverride "action_right_text" {
					text = "CM_OPEN_SETTINGS"
				}
			}
		}
	}
}
