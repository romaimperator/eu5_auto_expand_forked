						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_rgo_meets_minimum_discount_for_auto_expand').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_rgo_meets_minimum_discount_for_auto_expand').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_RGO_DISCOUNT"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.GetVariable('cm_expand_metric').GetValue, '(CFixedPoint)1'))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)]"
						}
