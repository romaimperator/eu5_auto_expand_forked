types cm_auto_expand {
	# used for location window (location_window.gui)
	type cm_auto_expand_rgo_widget_location_window = cm_auto_expand_rgo_widget {
		parentanchor = bottom|right
		# Flush against each other:
		# size = { 19 19 }
		# position = { -2 -1 }
		# Medium separated:
		size = { 18 18 }
		position = { -2 -1 }
		# Smaller separated:
		# size = { 16 16 }
		# position = { -2 -1 }
	}

	type cm_auto_expand_rgo_widget_expand_raw_goods_lateralview = button_square_checkbox {
		datacontext = "[Location]"
		size = { 20 20 }
		background = {
			texture = "gfx/interface/buttons/cm_glow_square.dds"
			texture_density = 2
			glow = {
				name = "green_glow"
				glow_radius = 5
				color = { 0.0 1.0 0.0 0.9 }
				alpha = 0.6
				block "green_glow_visible" { visible = "[And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]" }
			}
		}
		background = {
			texture = "gfx/interface/buttons/cm_glow_square.dds"
			texture_density = 2
			glow = {
				name = "red_glow"
				glow_radius = 5
				color = { 1.0 0.0 0.0 0.9 }
				alpha = 0.6
				block "red_glow_visible" { visible = "[And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)))]" }
			}
		}
		background = {
			texture = "gfx/interface/buttons/checkbox_bg_square.dds"
			texture_density = 2
			modify_texture = { using = color_black_texture blend_mode = multiply }
		}
		parentanchor = center
		widgetanchor = center
		tooltipwidget = { using = cm_RGO_Autoexpand_Tooltip }
		blockoverride "check_texture" {
			texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
		}
		blockoverride "checked_visible" {
			visible = "[GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
		}
		blockoverride "unchecked_visible" {
			visible = "[Not(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
		}
		action_tooltip = {
			click_type = left
			click_mode = single
			click_modifier = default
			title = "CM_AUTO_EXPAND_TOGGLE"
			on_action = "[GetScriptedGui('cm_set_auto_expand_for_rgo').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
		}
		action_tooltip = {
			click_type = left
			click_mode = single
			click_modifier = shift
			title = "CM_AUTO_EXPAND_RGO_SHIFT_TOGGLE"
			description = "CM_AUTO_EXPAND_RGO_SHIFT_TOGGLE_DESC"
			on_action = "[PdxGuiTriggerAllAnimations('cm_shift_click_mass_toggle_filtered_rgos')]"
		}
		using = cm_rightclick_open_settings_window
	}

	type cm_auto_expand_rgo_widget = widget {
		visible = "[ObjectsEqual(Location.GetOwner, GetPlayer)]"
		size = { 20 20 }

		button_square_checkbox = {
			size = { 100% 100% }
			background = {
				texture = "gfx/interface/buttons/cm_glow_square.dds"
				texture_density = 2
				glow = {
					name = "green_glow"
					glow_radius = 5
					color = { 0.0 1.0 0.0 0.9 }
					alpha = 0.6
					block "green_glow_visible" { visible = "[And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]" }
				}
			}
			background = {
				texture = "gfx/interface/buttons/cm_glow_square.dds"
				texture_density = 2
				glow = {
					name = "red_glow"
					glow_radius = 5
					color = { 1.0 0.0 0.0 0.9 }
					alpha = 0.6
					block "red_glow_visible" { visible = "[And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)))]" }
				}
			}
			background = {
				texture = "gfx/interface/buttons/checkbox_bg_square.dds"
				texture_density = 2
				modify_texture = { using = color_black_texture blend_mode = multiply }
			}
			parentanchor = center
			widgetanchor = center
			enabled = "[ObjectsEqual(Location.GetOwner, GetPlayer)]"
			tooltipwidget = {
				using = cm_RGO_Autoexpand_Tooltip
			}

			blockoverride "check_texture" {
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
			}
			blockoverride "checked_visible" {
				visible = "[GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
			}
			blockoverride "unchecked_visible" {
				visible = "[Not(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
			}

			action_tooltip = {
				click_type = left
				click_mode = single
				click_modifier = default
				title = "CM_AUTO_EXPAND_TOGGLE"
				on_action = "[GetScriptedGui('cm_set_auto_expand_for_rgo').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
			}
			action_tooltip = {
				click_type = left
				click_mode = single
				click_modifier = shift
				title = "CM_AUTO_EXPAND_RGO_SHIFT_TOGGLE"
				description = "CM_AUTO_EXPAND_RGO_SHIFT_TOGGLE_DESC"
				on_action = "[PdxGuiTriggerAllAnimations('cm_shift_click_mass_toggle_filtered_rgos')]"
			}
			using = cm_rightclick_open_settings_window
		}
	}

	type cm_debug_location_pop_type_breakdown = CMTooltipTextBlockContainer {
		blockoverride "text_content" {
			CMTooltipTextBox = {
				blockoverride "text" {
					raw_text = "[PopType.GetName] pop count: [GuiScope.SetRoot(Location.MakeScope).ScriptValue(Concatenate3('cm_location_', PopType.GetKey, '_pop_count'))]"
				}
			}
			CMTooltipTextBox = {
				blockoverride "text" {
					raw_text = "buildings need: [GuiScope.SetRoot(Location.MakeScope).ScriptValue(Concatenate3('cm_location_', PopType.GetKey, '_needed_for_buildings'))]"
				}
			}
			CMTooltipTextBox = {
				blockoverride "text" {
					raw_text = "available: [GuiScope.SetRoot(Location.MakeScope).ScriptValue(Concatenate3('cm_location_', PopType.GetKey, '_available'))]"
				}
			}
		}
	}

	type cm_mass_auto_expand_rgo_button = hbox {
		name = "cm_parent_of_auto_expand_active_rgos"

		# Hidden datamodels drive the shift-click filtered mass toggle on the standard
		# RGO auto-expand buttons (cm_auto_expand_rgo_widget). The shift handler calls
		# PdxGuiTriggerAllAnimations with the state name below; each visible item's
		# on_finish then flips its own RGO auto-expand. set_off is derived from
		# comparing active-vs-possible CountVisibleChildren so the toggle turns
		# everything off when they're all on, otherwise on.
		vbox = {
			size = { 0 0 }
			scissor = yes
			ignore_layout = yes
			name = "cm_auto_expand_active_rgos"
			datamodel = "[ExpandRawGoodsLateralView.GetRawGoodLocationItems]"
			item = {
				overlappingitembox = {
					datacontext = "[RawGoodLocationItem.GetLocation]"
					ignore_layout = yes
					visible = "[GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
				}
			}
		}

		vbox = {
			size = { 0 0 }
			scissor = yes
			ignore_layout = yes
			name = "cm_auto_expand_possible_rgos"
			datamodel = "[ExpandRawGoodsLateralView.GetRawGoodLocationItems]"
			item = {
				overlappingitembox = {
					datacontext = "[RawGoodLocationItem.GetLocation]"
					ignore_layout = yes
					visible = "[ObjectsEqual(Location.GetOwner, GetPlayer)]"
					state = {
						name = "cm_shift_click_mass_toggle_filtered_rgos"
						on_finish = "[GetScriptedGui('cm_set_auto_expand_for_rgo').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('set_off', MakeScopeBool(GreaterThanOrEqualTo_int32(PdxGuiWidget.FindParent('cm_parent_of_auto_expand_active_rgos').FindChild('cm_auto_expand_active_rgos').CountVisibleChildren, PdxGuiWidget.AccessParent.CountVisibleChildren))).End)]"
					}
				}
			}
		}

		button_square_checkbox = {
			size = { 20 20 }
			tooltipwidget = { using = cm_Mass_Autoexpand_RGO_Tooltip }
			blockoverride "check_texture" {
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
			}
			blockoverride "checked_visible" {
				visible = "[GetScriptedGui('cm_toggle_mass_auto_expand_rgo').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			blockoverride "unchecked_visible" {
				visible = "[Not(GetScriptedGui('cm_toggle_mass_auto_expand_rgo').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			}
			onclick = "[GetScriptedGui('cm_toggle_mass_auto_expand_rgo').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			using = cm_rightclick_open_settings_window
		}
	}
}

template cm_RGO_Autoexpand_Tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			cm_auto_expand_checkbutton = {
				using = tooltip_title_icon_size
				tooltip_enabled = no
				checked = "[GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
				enabled = yes
			}
		}

		blockoverride "title_text" {
			raw_text = "RGO Auto-Expand"
		}

		blockoverride "concept_link" {
			text = [resource_gathering_operations|e]
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)]"
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_ALL_REQUIREMENTS_MET"
				}
			}
			TooltipListBase = {
				visible = "[Not(GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"
				blockoverride "block_title" {
					raw_text = "Cannot expand until the following requirements are met:"
				}
				TooltipListRowContent = {
					cm_tooltip_row = {
						visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "first_element" { visible = yes }
						blockoverride "not_first_element" { visible = no }
						blockoverride "yes_visible" {
							visible = "[Not(GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "no_visible" {
							visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "row_text" {
							raw_text = "Auto-expand is not paused"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_auto_expand_rgos_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_auto_expand_rgos_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_auto_expand_rgos_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "RGO auto-expand feature is enabled"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_rgo_advance_researched').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_rgo_advance_researched').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_rgo_advance_researched').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "RGO is researched"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_rgo_not_max_level_already').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_rgo_not_max_level_already').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_rgo_not_max_level_already').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "RGO is not max level already"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_rgo_fully_employed').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_rgo_fully_employed').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_rgo_fully_employed').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "Location has enough [ShowPopTypeName('laborers')] and/or [ShowPopTypeName('slaves')] (available: [Multiply_CFixedPoint(GuiScope.SetRoot(Location.MakeScope).ScriptValue('cm_location_laborers_or_slaves_available'), '(CFixedPoint)1000')|0+=], monthly change: [Multiply_CFixedPoint(GuiScope.SetRoot(Location.MakeScope).ScriptValue('cm_combined_monthly_new_pops_of_type_laborers_or_slaves'), '(CFixedPoint)1000')|0+=])"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_rgo_meets_minimum_discount_for_auto_expand').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_rgo_meets_minimum_discount_for_auto_expand').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_rgo_meets_minimum_discount_for_auto_expand').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "RGO meets minimum construction discount"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.GetVariable('cm_expand_metric').GetValue, '(CFixedPoint)1'))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"
						}
						blockoverride "row_text" {
							raw_text = "RGO meets minimum income per level (estimated [Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase))|2]/[GetPlayer.MakeScope.GetVariableFromVariableMap('cm_priority_min_profit', MakeScopeFlag('cm_feature_auto_expand_rgos')).GetValue|2]@gold!)"
						}
					}
					cm_tooltip_row = {
						visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('cm_expand_metric').GetValue, '(CFixedPoint)2')]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"
						}
						blockoverride "row_text" {
							raw_text = "RGO meets minimum profit per level (currently [Location.GetRGOProfitPerLevel|2]/[GetPlayer.MakeScope.GetVariableFromVariableMap('cm_priority_min_profit', MakeScopeFlag('cm_feature_auto_expand_rgos')).GetValue|2]@gold!)"
						}
					}
					cm_tooltip_row = {
						visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('cm_expand_metric').GetValue, '(CFixedPoint)3')]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"
						}
						blockoverride "row_text" {
							raw_text = "RGO recoups its cost from income within the ROI limit (currently [Divide_CFixedPoint(Divide_CFixedPoint(GuiScope.AddScope('location', Location.MakeScope).AddScope('country', GetPlayer.MakeScope).ScriptValue('glorpui_rgo_expand_cost'), Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase))), '(CFixedPoint)12')|1]y/[GetPlayer.MakeScope.GetVariableFromVariableMap('cm_priority_min_profit', MakeScopeFlag('cm_feature_auto_expand_rgos')).GetValue|0]y)"
						}
					}
					cm_tooltip_row = {
						visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('cm_expand_metric').GetValue, '(CFixedPoint)4')]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"
						}
						blockoverride "row_text" {
							raw_text = "RGO recoups its cost from profit within the ROI limit (currently [Divide_CFixedPoint(Divide_CFixedPoint(GuiScope.AddScope('location', Location.MakeScope).AddScope('country', GetPlayer.MakeScope).ScriptValue('glorpui_rgo_expand_cost'), Location.GetRGOProfitPerLevel), '(CFixedPoint)12')|1]y/[GetPlayer.MakeScope.GetVariableFromVariableMap('cm_priority_min_profit', MakeScopeFlag('cm_feature_auto_expand_rgos')).GetValue|0]y)"
						}
					}
					cm_tooltip_row = {
						visible = "[And(InDebugMode, Not(GetScriptedGui('cm_is_rgo_under_construction').IsShown(GuiScope.SetRoot(Location.MakeScope).End)))]"
						background = { using = bg_tooltip_debug }
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_rgo_under_construction').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_rgo_under_construction').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "RGO isn't already under construction"
						}
					}
					cm_tooltip_row = {
						visible = "[And(InDebugMode, Not(GetScriptedGui('cm_is_there_enough_gold_available').IsShown(GuiScope.AddScope('location', Location.MakeScope).AddScope('country', GetPlayer.MakeScope).End)))]"
						using = cm_tooltip_row_is_odd
						background = { using = bg_tooltip_debug }
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_there_enough_gold_available').IsShown(GuiScope.AddScope('location', Location.MakeScope).AddScope('country', GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_there_enough_gold_available').IsShown(GuiScope.AddScope('location', Location.MakeScope).AddScope('country', GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "Country has [GetPlayer.GetCurrencyValue('gold')]@gold! vs required [GuiScope.AddScope('location', Location.MakeScope).AddScope('country', GetPlayer.MakeScope).ScriptValue('cm_expected_gold_available_for_rgo_auto_expand')]@gold!"
						}
					}
				}
			}

			CMTooltipTextBlockContainer = {
				visible = "[And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"

				blockoverride "text_content" {
					CMTooltipTextBox = {
						blockoverride "text" {
							raw_text = "RGO will expand if at least [GuiScope.AddScope('location', Location.MakeScope).AddScope('country', GetPlayer.MakeScope).ScriptValue('cm_expected_gold_available_for_rgo_auto_expand')|2]@gold! is available"
						}
					}
					CMTooltipTextBox = {
						blockoverride "text" {
							raw_text = "(min [GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('cm_get_minimum_gold')|0L]@gold! + cost [GuiScope.AddScope('location', Location.MakeScope).AddScope('country', GetPlayer.MakeScope).ScriptValue('glorpui_rgo_expand_cost')|2L]@gold!)"
						}
					}
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_light_green_texture
					}
				}
			}

			TooltipTextBlock = {
				visible = "[And(GetScriptedGui('cm_set_auto_expand_for_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_expand_rgo').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', GetPlayer.MakeScope).AddScope('profit', MakeScopeValue(Location.GetRGOProfitPerLevel)).AddScope('income', MakeScopeValue(Multiply_CFixedPoint(Location.GetRGOProfitPerLevel, Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)))]"
				blockoverride "text" {
					raw_text = "RGO will not expand; conditions are not met"
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_red_texture
					}
				}
			}

