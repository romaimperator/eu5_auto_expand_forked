							visible = "[Not(GetScriptedGui('cm_rgo_metric_gate_shown').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End))]"
						}
