template cm_rightclick_open_settings_window {
	onrightclick = "[GetScriptedGui(Select_CString(Or(Not(GameIsMultiplayer), IsHost), 'CMM_SetHostAndRegisterCoreMod', 'CMM_RegisterCoreMod')).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	onrightclick = "[GetVariableSystem.Set('cmm_window_open', 'true')]"
	onrightclick = "[GetVariableSystem.Set('cmm_selected_mod', 'cm')]"
	onrightclick = "[GetVariableSystem.Set('cmm_selected_tab', 'cm__settings')]"
}
