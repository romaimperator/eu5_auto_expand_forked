						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_CAN_BUILD_COUNTRY"
						}
					}
					cm_tooltip_row = {
						visible = "[EqualTo_CFixedPoint(GuiScope.AddScope('cm_location', Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).ScriptValue('cm_market_glass_disp_block'), '(CFixedPoint)1')]"
