types cm_auto_expand {
	type cm_auto_expand_checkbutton = checkbutton {
		texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
		texture_density = 2
		frame_grid = { 1 1 }
		size = { 30 30 }
	}

	# Placed in the production view and the build panel.
	type cm_auto_expand_existing_building_button = button_square_checkbox {
		datacontext = "[Building]"
		visible = "[And(Building.GetType.IsMultipleLevels, Not(GetScriptedGui('cm_is_building_obsolete').IsShown(GuiScope.SetRoot(Building.MakeScope).End)))]"
		size = { 20 20 }
		parentanchor = center
		widgetanchor = center
		tooltipwidget = { using = cm_Building_Autoexpand_Tooltip }
		blockoverride "check_texture" {
			texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
		}
		blockoverride "checked_visible" {
			visible = "[GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(Building.MakeScope).End)]"
		}
		blockoverride "unchecked_visible" {
			visible = "[Not(GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(Building.MakeScope).End))]"
		}
		background = {
			texture = "gfx/interface/buttons/cm_glow_square.dds"
			texture_density = 2
			glow = {
				name = "green_glow"
				glow_radius = 5
				color = { 0.0 1.0 0.0 0.9 }
				alpha = 0.6
				block "green_glow_visible" { visible = "[And(GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(Building.MakeScope).End), GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(Building.GetType, Building.GetLocation))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(Building.GetType, Building.GetLocation))).AddScope('cm_can_upgrade', MakeScopeBool(CanUpgradeToBuilding(Building.GetType.GetNextReplacementBuilding(Player.Self), Building.GetLocation))).End))]" }
			}
		}
		background = {
			texture = "gfx/interface/buttons/cm_glow_square.dds"
			texture_density = 2
			glow = {
				name = "red_glow"
				glow_radius = 5
				color = { 1.0 0.0 0.0 0.9 }
				alpha = 0.6
				block "red_glow_visible" { visible = "[And(GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(Building.MakeScope).End), Not(GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(Building.GetType, Building.GetLocation))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(Building.GetType, Building.GetLocation))).AddScope('cm_can_upgrade', MakeScopeBool(CanUpgradeToBuilding(Building.GetType.GetNextReplacementBuilding(Player.Self), Building.GetLocation))).End)))]" }
			}
		}
		background = {
			texture = "gfx/interface/buttons/checkbox_bg_square.dds"
			texture_density = 2
			modify_texture = {
				using = color_market_grey_texture
				blend_mode = add
				alpha = 0.5
			}
		}
		action_tooltip = {
			click_type = left
			click_mode = single
			click_modifier = default
			title = "CM_AUTO_EXPAND_TOGGLE"
			on_action = "[GetScriptedGui('cm_set_auto_expand_for_building').Execute(GuiScope.SetRoot(Building.MakeScope).End)]"
		}
		action_tooltip = {
			click_type = left
			click_mode = single
			click_modifier = shift
			title = "CM_AUTO_EXPAND_SHIFT_TOGGLE"
			description = "CM_AUTO_EXPAND_SHIFT_TOGGLE_DESC"
			on_action = "[PdxGuiTriggerAllAnimations('cm_shift_click_mass_toggle_filtered_building_types')]"
		}
		using = cm_rightclick_open_settings_window
	}

	# Building-view panel only; the panel has no grey container, so this button supplies its own background.
	type cm_auto_expand_existing_building_button_bv = button_square_checkbox {
		datacontext = "[Building]"
		visible = "[And(Building.GetType.IsMultipleLevels, Not(GetScriptedGui('cm_is_building_obsolete').IsShown(GuiScope.SetRoot(Building.MakeScope).End)))]"
		size = { 20 20 }
		tooltipwidget = { using = cm_Building_Autoexpand_Tooltip }
		blockoverride "check_texture" {
			texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
		}
		blockoverride "checked_visible" {
			visible = "[GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(Building.MakeScope).End)]"
		}
		blockoverride "unchecked_visible" {
			visible = "[Not(GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(Building.MakeScope).End))]"
		}
		# cm_glow_square has the alpha the glow needs; color_black multiply tints its white to the sibling grey.
		background = {
			texture = "gfx/interface/buttons/cm_glow_square.dds"
			texture_density = 2
			modify_texture = {
				using = color_black_texture
				blend_mode = multiply
			}
			glow = {
				name = "green_glow"
				glow_radius = 5
				color = { 0.0 1.0 0.0 0.9 }
				alpha = 0.6
				block "green_glow_visible" { visible = "[And(GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(Building.MakeScope).End), GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(Building.GetType, Building.GetLocation))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(Building.GetType, Building.GetLocation))).AddScope('cm_can_upgrade', MakeScopeBool(CanUpgradeToBuilding(Building.GetType.GetNextReplacementBuilding(Player.Self), Building.GetLocation))).End))]" }
			}
		}
		background = {
			texture = "gfx/interface/buttons/cm_glow_square.dds"
			texture_density = 2
			modify_texture = {
				using = color_black_texture
				blend_mode = multiply
			}
			glow = {
				name = "red_glow"
				glow_radius = 5
				color = { 1.0 0.0 0.0 0.9 }
				alpha = 0.6
				block "red_glow_visible" { visible = "[And(GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(Building.MakeScope).End), Not(GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(Building.GetType, Building.GetLocation))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(Building.GetType, Building.GetLocation))).AddScope('cm_can_upgrade', MakeScopeBool(CanUpgradeToBuilding(Building.GetType.GetNextReplacementBuilding(Player.Self), Building.GetLocation))).End)))]" }
			}
		}
		action_tooltip = {
			click_type = left
			click_mode = single
			click_modifier = default
			title = "CM_AUTO_EXPAND_TOGGLE"
			on_action = "[GetScriptedGui('cm_set_auto_expand_for_building').Execute(GuiScope.SetRoot(Building.MakeScope).End)]"
		}
		action_tooltip = {
			click_type = left
			click_mode = single
			click_modifier = shift
			title = "CM_AUTO_EXPAND_SHIFT_TOGGLE"
			description = "CM_AUTO_EXPAND_SHIFT_TOGGLE_DESC"
			on_action = "[PdxGuiTriggerAllAnimations('cm_shift_click_mass_toggle_filtered_building_types')]"
		}
		using = cm_rightclick_open_settings_window
	}

	# Placed in the production view and the build panel.
	type cm_auto_expand_new_building_button = widget {
		datacontext = "[BuildingType]"
		datacontext = "[Location]"
		size = { 20 20 }
		button_square_checkbox = {
			size = { 20 20 }
			parentanchor = center
			widgetanchor = center
			tooltipwidget = { using = cm_Building_Type_Autoexpand_Tooltip }
			blockoverride "check_texture" {
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
			}
			blockoverride "checked_visible" {
				visible = "[GetScriptedGui('cm_is_auto_expand_active_for_building_type').IsShown(GuiScope.SetRoot(BuildingType.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
			}
			blockoverride "unchecked_visible" {
				visible = "[Not(GetScriptedGui('cm_is_auto_expand_active_for_building_type').IsShown(GuiScope.SetRoot(BuildingType.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
			}
			background = {
				texture = "gfx/interface/buttons/cm_glow_square.dds"
				texture_density = 2
				glow = {
					name = "green_glow"
					glow_radius = 5
					color = { 0.0 1.0 0.0 0.9 }
					alpha = 0.6
					block "green_glow_visible" { visible = "[And(GetScriptedGui('cm_is_auto_expand_active_for_building_type').IsShown(GuiScope.SetRoot(BuildingType.MakeScope).AddScope('cm_location', Location.MakeScope).End), GetScriptedGui('cm_location_will_auto_expand_from_zero_levels').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(BuildingType.Self, Location.Self))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(BuildingType.Self, Location.Self))).End))]" }
				}
			}
			background = {
				texture = "gfx/interface/buttons/cm_glow_square.dds"
				texture_density = 2
				glow = {
					name = "red_glow"
					glow_radius = 5
					color = { 1.0 0.0 0.0 0.9 }
					alpha = 0.6
					block "red_glow_visible" { visible = "[And(GetScriptedGui('cm_is_auto_expand_active_for_building_type').IsShown(GuiScope.SetRoot(BuildingType.MakeScope).AddScope('cm_location', Location.MakeScope).End), Not(GetScriptedGui('cm_location_will_auto_expand_from_zero_levels').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(BuildingType.Self, Location.Self))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(BuildingType.Self, Location.Self))).End)))]" }
				}
			}
			background = {
				texture = "gfx/interface/buttons/checkbox_bg_square.dds"
				texture_density = 2
				modify_texture = {
					using = color_market_grey_texture
					blend_mode = add
					alpha = 0.5
				}
			}
			action_tooltip = {
				click_type = left
				click_mode = single
				click_modifier = default
				title = "CM_AUTO_EXPAND_TOGGLE"
				on_action = "[GetScriptedGui('cm_set_auto_expand_for_building_type').Execute(GuiScope.SetRoot(BuildingType.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
			}
			action_tooltip = {
				click_type = left
				click_mode = single
				click_modifier = shift
				title = "CM_AUTO_EXPAND_SHIFT_TOGGLE"
				description = "CM_AUTO_EXPAND_SHIFT_TOGGLE_DESC"
				on_action = "[PdxGuiTriggerAllAnimations('cm_shift_click_mass_toggle_filtered_building_types')]"
			}
			using = cm_rightclick_open_settings_window
		}
	}

	type cm_auto_expand_existing_building_button_pl = widget {
		size = { 20 44 }
		visible = "[ObjectsEqual(BuildingCandidate.GetBuilding.GetOwner, Player.Self)]"
		datacontext = "[BuildingCandidate.GetBuilding]"
		widget = {
			size = { 20 20 }
			parentanchor = center
			widgetanchor = center
			cm_auto_expand_existing_building_button = {}
		}
	}

	type cm_auto_expand_new_building_button_pl = widget {
		size = { 20 20 }
		visible = "[And(Location.HasOwner, EqualTo_string(Location.GetOwner.GetTag, GetPlayer.GetTag))]"
		cm_auto_expand_new_building_button = { parentanchor = center widgetanchor = center }
	}

	# Existing-building button if a building is already here, else the new-building button.
	type cm_auto_expand_building_button_bll = widget {
		size = { 20 44 }
		visible = "[And(ObjectsEqual(LocationToBuildItem.GetOwner, Player.Self), Not(LocationToBuildItem.IsForeignBuilding))]"
		datacontext = "[LocationToBuildItem.GetBuilding]"
		datacontext = "[LocationToBuildItem.GetLocation]"
		datacontext = "[LocationToBuildItem.GetBuildingType]"
		# Parent gate stops the button's scripted-gui checks from running on a zero-level slot's invalid building.
		widget = {
			visible = "[LocationToBuildItem.HasConstructedBuildingLevels]"
			size = { 20 20 }
			parentanchor = center
			widgetanchor = center
			cm_auto_expand_existing_building_button = {}
		}
		cm_auto_expand_new_building_button = { visible = "[Not(LocationToBuildItem.HasConstructedBuildingLevels)]" parentanchor = center widgetanchor = center }
	}

	type cm_building_cost_breakdown_tooltip = TooltipListBase {
		block "datacontext" {}
		margin = { 5 10 }
		vbox = {
			textbox = {
				using = tooltip_text_block_template
				text = "CM_BLD_COST_TT_MARKET_IMPACT"
			}
			textbox = {
				using = tooltip_text_block_template
				visible = "[Not(GetScriptedGui('cm_is_building_type_obsolete').IsShown(GuiScope.AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', Player.MakeScope).End))]"
				text = "CM_BLD_COST_TT_COST"
			}
			textbox = {
				using = tooltip_text_block_template
				visible = "[GetScriptedGui('cm_is_building_type_obsolete').IsShown(GuiScope.AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', Player.MakeScope).End)]"
				text = "CM_BLD_COST_TT_UPGRADE"
			}
		}
	}

	type cm_mass_auto_expand_button_bll = hbox {
		name = "cm_parent_of_auto_expand_active_locations"
		visible = "[And(Not(BuildInLocationLateralView.GetBuildingType.IsForeign), Not(GetScriptedGui('cm_is_building_type_obsolete').IsShown(GuiScope.AddScope('cm_building_type', BuildInLocationLateralView.GetBuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)))]"

		# Hidden datamodels drive the shift-click filtered mass toggle on the standard
		# auto-expand buttons named cm_auto_expand_production_*_checkbuttons. The shift
		# handler calls PdxGuiTriggerAllAnimations with the state name below; each
		# visible item's on_finish then flips its own auto-expand. set_off is derived
		# from comparing active-vs-possible CountVisibleChildren so the toggle turns
		# everything off when they're all on, otherwise on.
		vbox = {
			size = { 0 0 }
			scissor = yes
			ignore_layout = yes
			name = "cm_auto_expand_active_locations"
			datamodel = "[BuildInLocationLateralView.GetItems]"
			item = {
				overlappingitembox = {
					ignore_layout = yes
					visible = "[GetScriptedGui('cm_is_auto_expand_active_for_building_type').IsShown(GuiScope.SetRoot(LocationToBuildItem.GetBuildingType.MakeScope).AddScope('cm_location', LocationToBuildItem.GetLocation.MakeScope).End)]"
				}
			}
		}

		vbox = {
			size = { 0 0 }
			scissor = yes
			ignore_layout = yes
			name = "cm_auto_expand_possible_locations"
			datamodel = "[BuildInLocationLateralView.GetItems]"
			item = {
				overlappingitembox = {
					ignore_layout = yes
					visible = "[ObjectsEqual(LocationToBuildItem.GetLocation.GetOwner, GetPlayer)]"
					state = {
						name = "cm_shift_click_mass_toggle_filtered_building_types"
						on_finish = "[GetScriptedGui('cm_set_auto_expand_for_building_type').Execute(GuiScope.SetRoot(LocationToBuildItem.GetBuildingType.MakeScope).AddScope('cm_location', LocationToBuildItem.GetLocation.MakeScope).AddScope('cm_set_off', MakeScopeBool(GreaterThanOrEqualTo_int32(PdxGuiWidget.FindParent('cm_parent_of_auto_expand_active_locations').FindChild('cm_auto_expand_active_locations').CountVisibleChildren, PdxGuiWidget.AccessParent.CountVisibleChildren))).End)]"
					}
				}
			}
		}

		button_square_checkbox = {
			size = { 20 20 }
			tooltipwidget = { using = cm_Mass_Autoexpand_Tooltip }
			blockoverride "check_texture" {
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
			}
			blockoverride "checked_visible" {
				visible = "[GetScriptedGui('cm_toggle_mass_auto_expand_for_building_type').IsShown(GuiScope.SetRoot(BuildInLocationLateralView.GetBuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
			}
			blockoverride "unchecked_visible" {
				visible = "[Not(GetScriptedGui('cm_toggle_mass_auto_expand_for_building_type').IsShown(GuiScope.SetRoot(BuildInLocationLateralView.GetBuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End))]"
			}
			background = {
				texture = "gfx/interface/buttons/checkbox_bg_square.dds"
				texture_density = 2
				modify_texture = {
					using = color_market_grey_texture
					blend_mode = add
					alpha = 0.5
				}
			}
			onclick = "[GetScriptedGui('cm_toggle_mass_auto_expand_for_building_type').Execute(GuiScope.SetRoot(BuildInLocationLateralView.GetBuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
			using = cm_rightclick_open_settings_window
		}
	}

	type cm_mass_auto_expand_button_pl = button_square_checkbox {
		visible = "[And4(Not(BuildingItem.GetBuildingType.IsForeign), BuildingItem.GetBuildingType.IsMultipleLevels, Or(Not(ProductionView.IsLocationFilterEnabled), ObjectsEqual(ProductionView.GetSelectedLocation.GetOwner, Player.Self)), Not(GetScriptedGui('cm_is_building_type_obsolete').IsShown(GuiScope.AddScope('cm_building_type', BuildingItem.GetBuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)))]"
		size = { 20 20 }
		tooltipwidget = { using = cm_Mass_Autoexpand_Tooltip }
		blockoverride "check_texture" {
			texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
		}
		blockoverride "checked_visible" {
			visible = "[GetScriptedGui('cm_toggle_mass_auto_expand_for_building_type').IsShown(GuiScope.SetRoot(BuildingItem.GetBuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
		}
		blockoverride "unchecked_visible" {
			visible = "[Not(GetScriptedGui('cm_toggle_mass_auto_expand_for_building_type').IsShown(GuiScope.SetRoot(BuildingItem.GetBuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End))]"
		}
		background = {
			texture = "gfx/interface/buttons/checkbox_bg_square.dds"
			texture_density = 2
			modify_texture = {
				using = color_market_grey_texture
				blend_mode = add
				alpha = 0.5
			}
		}
		onclick = "[GetScriptedGui('cm_toggle_mass_auto_expand_for_building_type').Execute(GuiScope.SetRoot(BuildingItem.GetBuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
		using = cm_rightclick_open_settings_window
	}

}
template cm_Building_Autoexpand_Tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			cm_auto_expand_checkbutton = {
				using = tooltip_title_icon_size
				tooltip_enabled = no
				checked = "[GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(Building.MakeScope).End)]"
				enabled = yes
			}
		}

		blockoverride "title_text" {
			text = "CM_AUTO_EXPAND_BLD_TT_TITLE"
		}

		blockoverride "concept_link" {
			text = [building|e]
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[And(GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(Building.GetType, Building.GetLocation))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(Building.GetType, Building.GetLocation))).AddScope('cm_can_upgrade', MakeScopeBool(CanUpgradeToBuilding(Building.GetType.GetNextReplacementBuilding(Player.Self), Building.GetLocation))).End), GetScriptedGui('cm_can_build_building').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', Building.GetType.MakeScope).End))]"
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_ALL_REQUIREMENTS_MET"
				}
			}
			TooltipListBase = {
				visible = "[Not(And(GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(Building.GetType, Building.GetLocation))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(Building.GetType, Building.GetLocation))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(Building.GetType, Building.GetLocation))).AddScope('cm_can_upgrade', MakeScopeBool(CanUpgradeToBuilding(Building.GetType.GetNextReplacementBuilding(Player.Self), Building.GetLocation))).End), GetScriptedGui('cm_can_build_building').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', Building.GetType.MakeScope).End)))]"
				blockoverride "block_title" {
					text = "CM_AUTO_EXPAND_REQ_HEADER"
				}
				TooltipListRowContent = {
					cm_tooltip_row = {
						visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "first_element" { visible = yes }
						blockoverride "not_first_element" { visible = no }
						blockoverride "yes_visible" {
							visible = "[Not(GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "no_visible" {
							visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_NOT_PAUSED"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_auto_expand_buildings_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_auto_expand_buildings_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_auto_expand_buildings_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_BLD_ENABLED"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_location_not_conquered').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
