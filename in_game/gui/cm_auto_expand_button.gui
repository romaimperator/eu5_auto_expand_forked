						}
						blockoverride "row_text" {
							raw_text = "Building is not already under construction"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_location_has_enough_pops_available').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('building_type', Building.GetType.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_location_has_enough_pops_available').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('building_type', Building.GetType.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_location_has_enough_pops_available').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('building_type', Building.GetType.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "Location has enough [Building.GetType.GetPopType.GetName] available (available: [Multiply_CFixedPoint(GuiScope.SetRoot(Location.MakeScope).ScriptValue(Concatenate3('cm_location_', Building.GetType.GetPopType.GetKey, '_available')), '(CFixedPoint)1000')|0+=], monthly change: [Multiply_CFixedPoint(GuiScope.SetRoot(Location.MakeScope).ScriptValue(Concatenate('cm_combined_monthly_new_pops_of_type_', Building.GetType.GetPopType.GetKey)), '(CFixedPoint)1000')|0+=])"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_location_under_building_limit').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						blockoverride "vertical_line_size" { size = { 3 41 } }
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_location_under_building_limit').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_location_under_building_limit').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "Location has Supported Building Levels left     ([GuiScope.SetRoot(Location.MakeScope).ScriptValue('cm_get_available_building_levels')|+=] + #Y [GuiScope.SetRoot(GetPlayer.MakeScope).ScriptValue('cm_get_allowed_building_overbuild_levels')|0]#! overbuild = [GuiScope.SetRoot(Location.MakeScope).ScriptValue('cm_get_remaining_free_building_levels_allowed')|+=] remaining)"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_building_meets_minimum_discount_for_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_building_meets_minimum_discount_for_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_building_meets_minimum_discount_for_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).End))]"
						}
