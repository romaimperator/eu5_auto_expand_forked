					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_has_enough_gold_for_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).AddScope('cost', MakeScopeValue(GetBuildOrExpandBuildingCost(Building.GetType, Building.GetLocation))).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_has_enough_gold_for_auto_expand').IsShown(GuiScope.SetRoot(Building.MakeScope).AddScope('cost', MakeScopeValue(GetBuildOrExpandBuildingCost(Building.GetType, Building.GetLocation))).End)]"
						}
						blockoverride "no_visible" {
