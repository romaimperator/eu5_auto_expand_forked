						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_can_build_building').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).End))]"
