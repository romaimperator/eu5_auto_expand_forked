						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_building_not_max_level_and_not_obsolete_or_is_building_type_upgradeable_and_can_be_upgraded_by_owner').IsShown(GuiScope.SetRoot(Building.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_building_not_max_level_and_not_obsolete_or_is_building_type_upgradeable_and_can_be_upgraded_by_owner').IsShown(GuiScope.SetRoot(Building.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "At least one of these:"
						}
					}
					cm_tooltip_row_one_indent = {
						visible = "[And(Not(GetScriptedGui('cm_is_building_not_max_level_and_not_obsolete_or_is_building_type_upgradeable_and_can_be_upgraded_by_owner').IsShown(GuiScope.SetRoot(Building.MakeScope).End)), Not(GetScriptedGui('cm_is_building_not_max_level_already_and_not_obsolete').IsShown(GuiScope.SetRoot(Building.MakeScope).End)))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_building_not_max_level_already_and_not_obsolete').IsShown(GuiScope.SetRoot(Building.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_building_not_max_level_already_and_not_obsolete').IsShown(GuiScope.SetRoot(Building.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "All of these:"
						}
					}
					cm_tooltip_row_two_indent = {
						visible = "[And(Not(GetScriptedGui('cm_is_building_not_max_level_and_not_obsolete_or_is_building_type_upgradeable_and_can_be_upgraded_by_owner').IsShown(GuiScope.SetRoot(Building.MakeScope).End)), Not(GetScriptedGui('cm_is_building_not_max_level_already').IsShown(GuiScope.SetRoot(Building.MakeScope).End)))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_building_not_max_level_already').IsShown(GuiScope.SetRoot(Building.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_building_not_max_level_already').IsShown(GuiScope.SetRoot(Building.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "Building is not max level already"
						}
					}
					cm_tooltip_row_two_indent = {
						visible = "[And(Not(GetScriptedGui('cm_is_building_not_max_level_and_not_obsolete_or_is_building_type_upgradeable_and_can_be_upgraded_by_owner').IsShown(GuiScope.SetRoot(Building.MakeScope).End)), GetScriptedGui('cm_is_building_obsolete').IsShown(GuiScope.SetRoot(Building.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "vertical_line_size" { size = { 3 41 } }
						blockoverride "yes_visible" {
							visible = "[Not(GetScriptedGui('cm_is_building_obsolete').IsShown(GuiScope.SetRoot(Building.MakeScope).End))]"
						}
						blockoverride "no_visible" {
							visible = "[GetScriptedGui('cm_is_building_obsolete').IsShown(GuiScope.SetRoot(Building.MakeScope).End)]"
						}
						blockoverride "row_text" {
							raw_text = "Building does NOT have an upgrade available"
						}
					}
					cm_tooltip_row_one_indent = {
						visible = "[And(Not(GetScriptedGui('cm_is_building_not_max_level_and_not_obsolete_or_is_building_type_upgradeable_and_can_be_upgraded_by_owner').IsShown(GuiScope.SetRoot(Building.MakeScope).End)), Not(GetScriptedGui('cm_is_building_upgradeable_and_can_be_upgraded_by_owner_and_auto_expand_upgrade_is_on').IsShown(GuiScope.SetRoot(Building.MakeScope).End)))]"
						blockoverride "vertical_line_size" { size = { 3 115 } }
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_building_upgradeable_and_can_be_upgraded_by_owner_and_auto_expand_upgrade_is_on').IsShown(GuiScope.SetRoot(Building.MakeScope).End)]"
						}
						blockoverride "no_visible" {
