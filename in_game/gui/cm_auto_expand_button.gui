			CMTooltipTextBlockContainer = {
				visible = "[And(GetScriptedGui('cm_is_auto_expand_active_for_building_type').IsShown(GuiScope.SetRoot(BuildingType.MakeScope).AddScope('cm_location', Location.MakeScope).End), GetScriptedGui('cm_location_will_auto_expand_from_zero_levels').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(BuildingType.Self, Location.Self))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(BuildingType.Self, Location.Self))).End))]"

				blockoverride "text_content" {
					CMTooltipTextBox = {
						blockoverride "text" {
							text = "CM_AUTO_EXPAND_BLD_WILL_EXPAND"
						}
					}
					CMTooltipTextBox = {
						blockoverride "text" {
							text = "CM_AUTO_EXPAND_BLD_WILL_EXPAND_COSTS"
						}
					}
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_light_green_texture
					}
				}
			}

			TooltipTextBlock = {
				visible = "[And(GetScriptedGui('cm_is_auto_expand_active_for_building_type').IsShown(GuiScope.SetRoot(BuildingType.MakeScope).AddScope('cm_location', Location.MakeScope).End), Not(GetScriptedGui('cm_location_will_auto_expand_from_zero_levels').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(BuildingType.Self, Location.Self))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(BuildingType.Self, Location.Self))).End)))]"
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_BLD_WILL_NOT_EXPAND"
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_red_texture
					}
				}
			}

			cm_building_cost_breakdown_tooltip = {
				blockoverride "datacontext" {
					datacontext = "[BuildingType]"
				}
			}
		}

		blockoverride "tooltip_ui_action_block" {
			TooltipFunctionalBlock = {
				using = tooltip_left_right_click_template
				blockoverride "action_left_text" {
					text = "[UIAction.GetLeftClickName]"
				}
				blockoverride "action_right_text" {
					text = "CM_OPEN_SETTINGS"
				}
			}
			TooltipTextBlock = {
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_SHIFT_HINT"
				}
			}
		}
	}
}

template cm_Mass_Autoexpand_Tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			cm_auto_expand_checkbutton = {
				using = tooltip_title_icon_size
				tooltip_enabled = no
				enabled = yes
			}
		}

		blockoverride "title_text" {
			text = "CM_MASS_AUTO_EXPAND_TT_TITLE"
		}

		blockoverride "concept_link" {
			text = [building|e]
		}

		blockoverride "tooltip_content" {
			TooltipListBase = {
				blockoverride "block_title" {
					text = "CM_MASS_AUTO_EXPAND_TT_DESC"
				}
			}
		}

		blockoverride "tooltip_ui_action_block" {
			TooltipFunctionalBlock = {
				using = tooltip_left_right_click_template
				blockoverride "action_left_text" {
					text = "CM_AUTO_EXPAND_TOGGLE"
				}
				blockoverride "action_right_text" {
					text = "CM_OPEN_SETTINGS"
				}
			}
		}
	}
}
