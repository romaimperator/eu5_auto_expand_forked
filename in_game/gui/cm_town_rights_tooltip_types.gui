# Vanilla location_town_rights_tooltip (in_game/gui/shared/location_tooltips.gui:3535) with the best urban rights mapmode button added.

template location_town_rights_tooltip {
    ContextualTooltipType = {
        blockoverride "title_icon" {
            icon = {
                using = tooltip_title_icon_size
                texture = "[GetConceptTexture('town_rights')]"
            }
        }
        
        blockoverride "concept_link" {
            text = "[town_rights|e]"
        }
        blockoverride "title_text" {
            text = "LOCATION_TOWN_RIGHTS_TITLE"
        }

        # CM: best urban rights mapmode button
        blockoverride "title_button" {
            mapmode_tooltip_button = {
                datacontext = "[GetMapMode('cm_best_town_right')]"
            }
        }

        blockoverride "tooltip_content" {
			

			TooltipScrolledContentSection = { 
                blockoverride "block_scrollarea" {
                    maximumsize = { -1 550 }
                }
                blockoverride "section_content"	{
                    datamodel = "[Location.GetTownRights]"                
                    item = {	
                        vbox = {
                            spacing = 5
                            TooltipScrolledStringPairList = {
                                blockoverride "block_scrollarea" { maximumsize = { -1 360 } }
                                blockoverride "block_title" {
                                    raw_text = "#subtle_name [TownRights.GetType.GetIcon] [TownRights.GetType.GetNameWithNoTooltip]#!"
                                }
                                textcontext = "[TownRights.GetType.GetTooltip][TownRights.GetType.GetDebugTooltip(Location.Self)]"
                            }
                            TooltipFlavorTextBlock = {
                                visible = "[Not(StringIsEmpty(TownRights.GetType.GetDesc))]"
                                blockoverride "text" {
                                    text = "[TownRights.GetType.GetDesc]"
                                }
                            }
                        }
                    }
                }                
			}
		}
    }
}

types cm_town_rights_tooltip_types {
	# Search mapmode buttons for an urban right's tooltips; the one matching the
	# TownRightsType in context shows.
	type cm_trmm_search_title_buttons = widget {
		size = { 40 40 }
		visible = "[GetScriptedGui('cm_trmm_is_search_any').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End)]"

		mapmode_tooltip_button = {
			visible = "[And(CanChangeMapMode, GetScriptedGui('cm_trmm_is_search_tooling').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End))]"
			datacontext = "[GetMapMode('cm_trmm_search_tooling')]"
		}

		mapmode_tooltip_button = {
			visible = "[And(CanChangeMapMode, GetScriptedGui('cm_trmm_is_search_jewelry').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End))]"
			datacontext = "[GetMapMode('cm_trmm_search_jewelry')]"
		}

		mapmode_tooltip_button = {
			visible = "[And(CanChangeMapMode, GetScriptedGui('cm_trmm_is_search_naval').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End))]"
			datacontext = "[GetMapMode('cm_trmm_search_naval')]"
		}

		mapmode_tooltip_button = {
			visible = "[And(CanChangeMapMode, GetScriptedGui('cm_trmm_is_search_textile').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End))]"
			datacontext = "[GetMapMode('cm_trmm_search_textile')]"
		}

		mapmode_tooltip_button = {
			visible = "[And(CanChangeMapMode, GetScriptedGui('cm_trmm_is_search_weaponry').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End))]"
			datacontext = "[GetMapMode('cm_trmm_search_weaponry')]"
		}

		mapmode_tooltip_button = {
			visible = "[And(CanChangeMapMode, GetScriptedGui('cm_trmm_is_search_book').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End))]"
			datacontext = "[GetMapMode('cm_trmm_search_book')]"
		}

		mapmode_tooltip_button = {
			visible = "[And(CanChangeMapMode, GetScriptedGui('cm_trmm_is_search_artisan').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End))]"
			datacontext = "[GetMapMode('cm_trmm_search_artisan')]"
		}

		mapmode_tooltip_button = {
			visible = "[And(CanChangeMapMode, GetScriptedGui('cm_trmm_is_search_brewing').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End))]"
			datacontext = "[GetMapMode('cm_trmm_search_brewing')]"
		}

		mapmode_tooltip_button = {
			visible = "[And(CanChangeMapMode, GetScriptedGui('cm_trmm_is_search_masonry').IsShown(GuiScope.SetRoot(TownRightsType.MakeScope).End))]"
			datacontext = "[GetMapMode('cm_trmm_search_masonry')]"
		}
	}
}

# Vanilla TownRightsType_tooltip (in_game/gui/shared/location_tooltips.gui:6995) with the per-right search mapmode button added.
template TownRightsType_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[TownRightsType.GetNameWithNoTooltip]"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[TownRightsType.GetIcon]"
			}
		}

        blockoverride "title_button" {
            mapmode_tooltip_button = {
                datacontext = "[GetMapMode('town_rights')]"
            }

            # CM: per-right search mapmode button
            cm_trmm_search_title_buttons = {}

            hint_button = {
                action_tooltip = {
                    title = "OPEN_HINT"
                    on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_town_rights')]"
                }
            }
        }

		blockoverride "concept_link" {
			text = [town_rights|E]
		}
		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[TownRightsType.GetDebugText]"
				}
			}

			TooltipStringPairList = {
				textcontext = "[TownRightsType.GetTooltip]"
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[TownRightsType.GetDesc]"
				}
			}
		}
		blockoverride "extra_tooltip_content" {
			TooltipScrolledRequirementsList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
				blockoverride "block_title" {
					text = "game_concept_conditions"
					visible = "[DataModelHasItems(RequirementsList.GetLines)]"
				}
				blockoverride "requirementslist_datamodel_is_empty" { visible = no }
				visible = "[UIAction.IsLeftClickAndConfirmEnabled]"
				textcontext = "[UIAction.GetConditions]"
			}
		}
	}
}

# Vanilla TownRightsItem_tooltip (in_game/gui/shared/location_tooltips.gui:7055) with the per-right search mapmode button added.
template TownRightsItem_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[TownRightsItem.GetType.GetNameWithNoTooltip]"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[TownRightsItem.GetType.GetIcon]"
			}
		}
		blockoverride "title_button" {
			mapmode_tooltip_button = {
				datacontext = "[GetMapMode('town_rights')]"
			}

			# CM: per-right search mapmode button
			cm_trmm_search_title_buttons = {
				datacontext = "[TownRightsItem.GetType]"
			}

			hint_button = {
				action_tooltip = {
					title = "OPEN_HINT"
					on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_town_rights')]"
				}
			}
		}
		blockoverride "concept_link" {
			text = [town_rights|E]
		}
		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				textcontext = "[TownRightsItem.GetType.GetTooltip]"
			}
			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[TownRightsItem.GetType.GetDesc]"
				}
			}

            TooltipScrolledRowList = {
                blockoverride "block_scrollarea" { maximumsize = { -1 420 }}
                blockoverride "block_title" {
					text = "TOWN_RIGHTS_ITEM_LOCATIONS_TITLE"
					default_format = "#color_white"
				}
                blockoverride "rowlist_datamodel_is_empty" { visible = "[IsDataModelEmpty(TownRightsItem.GetLocations)]"}
                blockoverride "rowlist_datamodel_has_items" { visible = "[DataModelHasItems(TownRightsItem.GetLocations)]"}
                blockoverride "rowlist_datamodel" { datamodel = "[TownRightsItem.GetLocations]" }
                blockoverride "rowlist_item" { text = "[LocationReference.GetLocation.GetName]" }
            }
		}
	}
}
