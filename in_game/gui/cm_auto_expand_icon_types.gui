types cm_auto_expand_icon_types {
	type cm_is_auto_expand_on_icon_green = icon {
		visible = "[And3(ObjectsEqual(GetPlayer.Self, LocationBuildingItem.GetBuilding.GetOwner), GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(LocationBuildingItem.GetBuilding.MakeScope).End), GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(LocationBuildingItem.GetBuilding.MakeScope).End))]"
		parentanchor = bottom|left
		position = { 19 -18 }
		using = cm_icon_green_glow
	}

	type cm_is_auto_expand_on_icon_red = icon {
		visible = "[And3(ObjectsEqual(GetPlayer.Self, LocationBuildingItem.GetBuilding.GetOwner), GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(LocationBuildingItem.GetBuilding.MakeScope).End), Not(GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(LocationBuildingItem.GetBuilding.MakeScope).End)))]"
		parentanchor = bottom|left
		position = { 19 -18 }
		using = cm_icon_red_glow
	}
}

template cm_icon_green_glow {
	texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
	size = { 16 16 }
	glow = {
		name = "green_glow"
		glow_radius = 4
		color = {0.0 1.0 0.0 0.9}
		alpha = 0.6
	}
}

template cm_icon_red_glow {
	texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
	size = { 16 16 }
	glow = {
		name = "red_glow"
		glow_radius = 4
		color = {1.0 0.0 0.0 0.9}
		alpha = 0.6
	}
}
