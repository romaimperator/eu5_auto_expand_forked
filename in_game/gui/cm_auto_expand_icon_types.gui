types cm_auto_expand_icon_types {
	# Auto-expand status badge on the building card. The outer gate is a non-throwing check;
	# the inner scripted-gui calls never evaluate on a zero-level slot, whose building is invalid.
	type cm_is_auto_expand_on_icon = widget {
		visible = "[LocationBuildingItem.GetBuilding.GetType.IsMultipleLevels]"
		parentanchor = top|right
		position = { 1 -1 }
		size = { 10 10 }
		widget = {
			visible = "[And(ObjectsEqual(GetPlayer.Self, LocationBuildingItem.GetBuilding.GetOwner), GetScriptedGui('cm_is_auto_expand_active_for_building').IsShown(GuiScope.SetRoot(LocationBuildingItem.GetBuilding.MakeScope).End))]"
			size = { 100% 100% }
			using = bg_circle
			icon = {
				visible = "[GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(LocationBuildingItem.GetBuilding.MakeScope).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(LocationBuildingItem.GetBuilding.GetType, LocationBuildingItem.GetBuilding.GetLocation))).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(LocationBuildingItem.GetBuilding.GetType, LocationBuildingItem.GetBuilding.GetLocation))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(LocationBuildingItem.GetBuilding.GetType, LocationBuildingItem.GetBuilding.GetLocation))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(LocationBuildingItem.GetBuilding.GetType, LocationBuildingItem.GetBuilding.GetLocation))).AddScope('cm_can_upgrade', MakeScopeBool(CanUpgradeToBuilding(LocationBuildingItem.GetBuilding.GetType.GetNextReplacementBuilding(Player.Self), LocationBuildingItem.GetBuilding.GetLocation))).End)]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
				glow = { name = "green_glow" glow_radius = 4 color = { 0.0 1.0 0.0 0.9 } alpha = 0.6 }
			}
			icon = {
				visible = "[Not(GetScriptedGui('cm_is_building_able_to_auto_expand').IsShown(GuiScope.SetRoot(LocationBuildingItem.GetBuilding.MakeScope).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(LocationBuildingItem.GetBuilding.GetType, LocationBuildingItem.GetBuilding.GetLocation))).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(LocationBuildingItem.GetBuilding.GetType, LocationBuildingItem.GetBuilding.GetLocation))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(LocationBuildingItem.GetBuilding.GetType, LocationBuildingItem.GetBuilding.GetLocation))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(LocationBuildingItem.GetBuilding.GetType, LocationBuildingItem.GetBuilding.GetLocation))).AddScope('cm_can_upgrade', MakeScopeBool(CanUpgradeToBuilding(LocationBuildingItem.GetBuilding.GetType.GetNextReplacementBuilding(Player.Self), LocationBuildingItem.GetBuilding.GetLocation))).End))]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
				glow = { name = "red_glow" glow_radius = 4 color = { 1.0 0.0 0.0 0.9 } alpha = 0.6 }
			}
		}
	}
}
