# Construction executor: the monthly dispatcher stages candidates into per-cycle queue lists,
# and this always-present widget drains them one cycle later and runs the builds.
# Cost, income, and next-tier values come from GUI-only engine bindings, so building runs here.
widget = {
	name = "cm_construct_queue_window"
	# Keeps descendant visibility gates re-evaluating each frame.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	position = { -10000 1 }
	widget = {
		# Per-cycle driver: tears down when cm_should_construct clears and rebuilds next cycle, re-running _show.
		widget = {
			size = { 0 0 }
			visible = "[And(GetPlayer.Exists, GetScriptedGui('cm_should_construct').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			# Step lengths only pace the loop; completion is decided by cm_q_sync_check.
			state = {
				name = _show
				duration = 0.1
				next = cm_q_round_fire
			}
			# Rounds are safe to repeat: executors skip entries already processed this cycle.
			state = {
				name = cm_q_round_fire
				duration = 0.15
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_construct')]"
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_construct_upgrade')]"
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_construct_ungated')]"
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_construct_urbanize')]"
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_construct_food')]"
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_construct_food_rgo')]"
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_construct_rgo')]"
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_probe')]"
				next = cm_q_round_check
			}
			state = {
				name = cm_q_round_check
				duration = 0.15
				on_finish = "[GetScriptedGui('cm_q_sync_check').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				next = cm_q_round_fire
			}
		}
		# Fire driver: the gate flag flips once per cycle, so _show runs the engine actions exactly once.
		widget = {
			size = { 0 0 }
			visible = "[And(GetPlayer.Exists, GetScriptedGui('cm_q_fire_approved_gate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			state = {
				name = _show
				duration = 0.1
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_fire_build')]"
				on_finish = "[PdxGuiTriggerAllAnimations('cm_q_fire_upgrade')]"
				next = cm_q_fire_done
			}
			# 0.25s lets the fire playbacks land before teardown; one deferred past it drops rather than double-fires.
			state = {
				name = cm_q_fire_done
				duration = 0.25
				on_finish = "[GetScriptedGui('cm_q_end_cycle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
		# Metric-gated building constructs: per-location list of building types.
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('cm_q_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					datamodel = "[Location.MakeScope.GetList('cm_q_building_types')]"
					item = {
						widget = {
							datacontext = "[Scope.GetBuildingType]"
							state = {
								name = cm_q_construct
								on_finish = "[GetScriptedGui('cm_gui_try_build').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(BuildingType.Self, Location.Self))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(BuildingType.Self, Location.Self))).AddScope('cm_obsolete_building', BuildingType.GetObsoleteBuildingInLocation(Location.Self, Player.Self).MakeScope).End)]"
							}
						}
					}
				}
			}
		}
		# Obsolete-building upgrades: per-location list of obsolete types, replaced with the engine's next tier.
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('cm_gui_upgrade_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					datamodel = "[Location.MakeScope.GetList('cm_gui_upgrade_building_types')]"
					item = {
						widget = {
							datacontext = "[Scope.GetBuildingType]"
							state = {
								name = cm_q_construct_upgrade
								on_finish = "[GetScriptedGui('cm_gui_construct_upgrade').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_old_building_type', BuildingType.MakeScope).AddScope('cm_new_building_type', BuildingType.GetNextReplacementBuilding(Player.Self).MakeScope).AddScope('cm_building_type', BuildingType.GetNextReplacementBuilding(Player.Self).MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.GetNextReplacementBuilding(Player.Self), Location.Self))).AddScope('cm_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(BuildingType.GetNextReplacementBuilding(Player.Self), Location.Self))).AddScope('cm_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(BuildingType.GetNextReplacementBuilding(Player.Self), Location.Self))).AddScope('cm_can_build', MakeScopeBool(CanUpgradeToBuilding(BuildingType.GetNextReplacementBuilding(Player.Self), Location.Self))).End)]"
							}
						}
					}
				}
			}
		}
		# Ungated building constructs for auto-build and capital: per-location list of building types.
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('cm_q_ungated_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					datamodel = "[Location.MakeScope.GetList('cm_q_ungated_building_types')]"
					item = {
						widget = {
							datacontext = "[Scope.GetBuildingType]"
							state = {
								name = cm_q_construct_ungated
								on_finish = "[GetScriptedGui('cm_gui_try_ungated').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(BuildingType.Self, Location.Self))).End)]"
							}
						}
					}
				}
			}
		}
		# Urbanize rank upgrades: per-location list of upgrade building types.
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('cm_q_urbanize_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					datamodel = "[Location.MakeScope.GetList('cm_q_urbanize_building_types')]"
					item = {
						widget = {
							datacontext = "[Scope.GetBuildingType]"
							state = {
								name = cm_q_construct_urbanize
								on_finish = "[GetScriptedGui('cm_gui_try_urbanize').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).End)]"
							}
						}
					}
				}
			}
		}
		# Food buildings: per-location list of the chosen food building type.
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('cm_q_food_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					datamodel = "[Location.MakeScope.GetList('cm_q_food_building_types')]"
					item = {
						widget = {
							datacontext = "[Scope.GetBuildingType]"
							state = {
								name = cm_q_construct_food
								on_finish = "[GetScriptedGui('cm_gui_try_food_building').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).AddScope('cm_can_build', MakeScopeBool(CanBuildOrExpandBuilding(BuildingType.Self, Location.Self))).End)]"
							}
						}
					}
				}
			}
		}
		# Food RGO upgrades: per-location; the executor re-checks slots and the food gold reserve.
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('cm_q_food_rgo_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					state = {
						name = cm_q_construct_food_rgo
						on_finish = "[GetScriptedGui('cm_gui_try_food_rgo').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
					}
				}
			}
		}
		# RGO upgrades: per-location; the executor re-checks eligibility and gold.
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('cm_q_rgo_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					state = {
						name = cm_q_construct_rgo
						on_finish = "[GetScriptedGui('cm_gui_try_rgo').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_location', Location.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).AddScope('cm_profit', MakeScopeValue(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl))).AddScope('cm_income', MakeScopeValue(Multiply_CFixedPoint(Divide_CFixedPoint(Location.GetRGOProfitPerLevel, Location.GetControl), Divide_CFixedPoint(Location.GetTotalIncome, Location.GetTotalPossibleTaxBase)))).End)]"
					}
				}
			}
		}
		# Approved builds from the executors; each entry fires the engine build action once.
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('cm_q_approved_build_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					datamodel = "[Location.MakeScope.GetList('cm_q_approved_build_types')]"
					item = {
						widget = {
							datacontext = "[Scope.GetBuildingType]"
							state = {
								name = cm_q_fire_build
								on_finish = "[BuildOrExpandBuildingDefault(BuildingType.Self, Location.Self)]"
							}
							# Probe on a child so its re-triggers stay off the fire state's machine.
							widget = {
								size = { 0 0 }
								state = {
									name = cm_q_probe
									on_finish = "[GetScriptedGui('cm_q_probe_build').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).End)]"
								}
							}
						}
					}
				}
			}
		}
		# Approved upgrades keyed by the obsolete type; each entry fires the engine upgrade action on the replacement.
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('cm_q_approved_upgrade_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					datamodel = "[Location.MakeScope.GetList('cm_q_approved_upgrade_types')]"
					item = {
						widget = {
							datacontext = "[Scope.GetBuildingType]"
							state = {
								name = cm_q_fire_upgrade
								on_finish = "[UpgradeBuildingDefault(BuildingType.GetNextReplacementBuilding(Player.Self), Location.Self)]"
							}
							widget = {
								size = { 0 0 }
								state = {
									name = cm_q_probe
									on_finish = "[GetScriptedGui('cm_q_probe_upgrade').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).End)]"
								}
							}
						}
					}
				}
			}
		}
	}
}
