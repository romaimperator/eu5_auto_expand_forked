basic_dialog = {
	name = "cm_hidden_window"
	widgetid = cm_hidden_window
	layer = top
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	parentanchor = center

	position = { -10000 1 }
	blockoverride "header_text" {
		raw_text = "CM: Hidden Window"
	}
	blockoverride "content" {
		vbox = {
			visible = "[GetPlayer.Exists]"

			widget = {
				size = { 0 0 }
				visible = "[GetScriptedGui('cm_should_refresh_country_variables').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				state = {
					name = _show
					on_start = "[GetScriptedGui('cm_refresh_country_variables').Execute(GuiScope.AddScope('cm_country', GetPlayer.MakeScope).End)]"
				}
			}

			vbox = {
				name = building_type_section
				visible_at_creation = no
				state = {
					name = _show
					duration = 0.5
					next = cm_building_type_pass_produced
					on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_buildings_construction_demand_state')]"
				}
				state = {
					name = cm_building_type_pass_produced
					next = cm_building_type_pass_init
					on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_produced_good_state')]"
				}
				state = {
					name = cm_building_type_pass_init
					on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_buildings_init_state')]"
				}
				visible = "[GetScriptedGui('cm_should_building_type_section_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
				text_single = {
					raw_text = "Building type section"
				}
				datamodel = "[GetGlobalList('cm_building_types_to_process')]"
				item = {
					hbox = {
						datacontext = "[Scope.GetBuildingType]"
						state = {
							name = cm_building_type_section_buildings_init_state
							on_finish = "[GetScriptedGui('cm_building_type_section_buildings_init').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('is_producing', MakeScopeBool(BuildingType.IsProducing)).AddScope('is_multiple_levels', MakeScopeBool(BuildingType.IsMultipleLevels)).AddScope('is_fort', MakeScopeBool(BuildingType.IsFort)).AddScope('pop_type', BuildingType.GetPopType.MakeScope).AddScope('upgrade_type', BuildingType.GetNextReplacementBuilding(Player.Self).MakeScope).End)]"
						}
						vbox = {
							margin = { 5 0 }
							visible = "[BuildingType.HasConstructionGoodsDemand]"
							datamodel = "[BuildingType.GetConstructionDemand.GetEntries]"
							item = {
								overlappingitembox = {
									state = {
										name = cm_building_type_section_buildings_construction_demand_state
										on_finish = "[GetScriptedGui('cm_construction_demand').Execute(GuiScope.AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_good', GoodsDemandEntry.GetGoods.MakeScope).AddScope('amount', MakeScopeValue(GoodsDemandEntry.GetValue)).End)]"
									}
								}
							}
						}
						vbox = {
							visible = "[BuildingType.IsProducing]"
							datamodel = "[BuildingType.GetPossibleProductionMethods]"
							item = {
								vbox = {
									datamodel = "[PossibleProductionMethods.GetMethods]"
									item = {
										widget = {
											visible = "[ProductionMethod.IsProducing]"
											state = {
												name = cm_building_type_section_produced_good_state
												on_finish = "[GetScriptedGui('cm_produced_good').Execute(GuiScope.AddScope('cm_building_type', BuildingType.MakeScope).AddScope('produced_good', ProductionMethod.GetProduced.MakeScope).End)]"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
