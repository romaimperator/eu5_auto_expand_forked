# Always-present hidden window that classifies every building type once per lobby. Engine bindings like
# IsProducing and GetNextReplacementBuilding read only in GUI, so classification runs here and writes
# maps that script reads.
widget = {
	name = "cm_hidden_window"
	# Keeps descendant visibility gates re-evaluating each frame.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	position = { -10000 1 }
	widget = {
		visible = "[GetPlayer.Exists]"

		# Building-type classification: runs once per lobby and writes the type maps that script reads.
		vbox = {
			name = building_type_section
			visible_at_creation = no
			# Pass 1: record each type's per-good construction demand.
			state = {
				name = _show
				next = cm_building_type_pass_produced
				on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_buildings_construction_demand_state')]"
			}
			# Pass 2: record each producing type's output good.
			state = {
				name = cm_building_type_pass_produced
				next = cm_building_type_pass_init
				on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_produced_good_state')]"
			}
			# Pass 3: record producing/multi-level/fort flags, pop type, and upgrade target.
			state = {
				name = cm_building_type_pass_init
				on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_buildings_init_state')]"
			}
			visible = "[GetScriptedGui('cm_should_building_type_section_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End)]"
			datamodel = "[GetGlobalList('cm_building_types_to_process')]"
			item = {
				hbox = {
					datacontext = "[Scope.GetBuildingType]"
					state = {
						name = cm_building_type_section_buildings_init_state
						on_finish = "[GetScriptedGui('cm_building_type_section_buildings_init').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_is_producing', MakeScopeBool(BuildingType.IsProducing)).AddScope('cm_is_multiple_levels', MakeScopeBool(BuildingType.IsMultipleLevels)).AddScope('cm_is_fort', MakeScopeBool(BuildingType.IsFort)).AddScope('cm_pop_type', BuildingType.GetPopType.MakeScope).AddScope('cm_upgrade_type', BuildingType.GetNextReplacementBuilding(Player.Self).MakeScope).End)]"
					}
					vbox = {
						margin = { 5 0 }
						visible = "[BuildingType.HasConstructionGoodsDemand]"
						datamodel = "[BuildingType.GetConstructionDemand.GetEntries]"
						item = {
							overlappingitembox = {
								state = {
									name = cm_building_type_section_buildings_construction_demand_state
									on_finish = "[GetScriptedGui('cm_construction_demand').Execute(GuiScope.AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_good', GoodsDemandEntry.GetGoods.MakeScope).AddScope('cm_amount', MakeScopeValue(GoodsDemandEntry.GetValue)).End)]"
								}
							}
						}
					}
					vbox = {
						visible = "[BuildingType.IsProducing]"
						datamodel = "[BuildingType.GetPossibleProductionMethods]"
						item = {
							vbox = {
								datamodel = "[PossibleProductionMethods.GetMethods]"
								item = {
									widget = {
										visible = "[ProductionMethod.IsProducing]"
										state = {
											name = cm_building_type_section_produced_good_state
											on_finish = "[GetScriptedGui('cm_produced_good').Execute(GuiScope.AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_produced_good', ProductionMethod.GetProduced.MakeScope).End)]"
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
