basic_dialog = {
	name = "cm_hidden_window"
	widgetid = cm_hidden_window
	layer = top
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	parentanchor = center

	position = { -10000 1 }
	blockoverride "header_text" {
		raw_text = "CM: Hidden Window"
	}
	blockoverride "content" {
		vbox = {
			visible = "[GetPlayer.Exists]"

			overlappingitembox = {
				state = {
					name = cm_hidden_window_repeated_init
					trigger_on_create = yes
					duration = 2
					on_finish = "[GetScriptedGui('cm_hidden_window_repeated_init').Execute(GuiScope.AddScope('country', GetPlayer.MakeScope).AddScope('skip', MakeScopeBool('(bool)no')).End)]"
					on_finish = "[PdxGuiTriggerAllAnimations('cm_do_upgrade')]"
					on_finish = "[PdxGuiWidget.TriggerAnimation('cm_hidden_window_repeated_init')]"
				}
			}

			vbox = {
				name = building_type_section
				state = {
					name = cm_building_type_section_init
					trigger_on_create = yes
					on_start = "[PdxGuiTriggerAllAnimations('cm_building_type_section_buildings_construction_demand_state')]"
					on_start = "[PdxGuiTriggerAllAnimations('cm_building_type_section_produced_good_state')]"
					duration = 2
					on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_buildings_init_state')]"
					on_finish = "[PdxGuiWidget.TriggerAnimation('cm_building_type_section_init')]"
				}
				visible = "[GetScriptedGui('cm_should_building_type_section_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('country', GetPlayer.MakeScope).End)]"
				text_single = {
					raw_text = "Building type section"
				}
				datamodel = "[GetGlobalList('cm_building_types_to_process')]"
				item = {
					hbox = {
						datacontext = "[Scope.GetBuildingType]"
						state = {
							name = cm_building_type_section_buildings_init_state
							on_finish = "[GetScriptedGui('cm_building_type_section_buildings_init').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('building_type', BuildingType.MakeScope).AddScope('is_producing', MakeScopeBool(BuildingType.IsProducing)).AddScope('is_multiple_levels', MakeScopeBool(BuildingType.IsMultipleLevels)).AddScope('is_fort', MakeScopeBool(BuildingType.IsFort)).AddScope('pop_type', BuildingType.GetPopType.MakeScope).AddScope('upgrade_type', BuildingType.GetNextReplacementBuilding(Player.Self).MakeScope).End)]"
						}
						vbox = {
							margin = { 5 0 }
							visible = "[BuildingType.HasConstructionGoodsDemand]"
							datamodel = "[BuildingType.GetConstructionDemand.GetEntries]"
							item = {
								overlappingitembox = {
									state = {
										name = cm_building_type_section_buildings_construction_demand_state
										on_finish = "[GetScriptedGui('cm_construction_demand').Execute(GuiScope.AddScope('building_type', BuildingType.MakeScope).AddScope('good', GoodsDemandEntry.GetGoods.MakeScope).AddScope('amount', MakeScopeValue(GoodsDemandEntry.GetValue)).End)]"
									}
								}
							}
						}
						vbox = {
							visible = "[BuildingType.IsProducing]"
							datamodel = "[BuildingType.GetPossibleProductionMethods]"
							item = {
								vbox = {
									datamodel = "[PossibleProductionMethods.GetMethods]"
									item = {
										widget = {
											visible = "[ProductionMethod.IsProducing]"
											state = {
												name = cm_building_type_section_produced_good_state
												on_finish = "[GetScriptedGui('cm_produced_good').Execute(GuiScope.AddScope('building_type', BuildingType.MakeScope).AddScope('produced_good', ProductionMethod.GetProduced.MakeScope).End)]"
											}
										}
									}
								}
							}
						}
					}
				}
			}

			# Upgrade processing: iterates locations/building types flagged by the monthly script tick.
			# The scripted GUI resolves the upgrade target via cm_find_upgrade_building_type.
			# Triggered once per month by the repeated_init loop when cm_gui_upgrades_pending is set.
			vbox = {
				datamodel = "[GetPlayer.MakeScope.GetList('cm_gui_upgrade_locations')]"
				item = {
					vbox = {
						datacontext = "[Scope.GetLocation]"
						datamodel = "[Location.MakeScope.GetList('cm_gui_upgrade_building_types')]"
						item = {
							hbox = {
								datacontext = "[Scope.GetBuildingType]"
								state = {
									name = cm_do_upgrade
									on_finish = "[GetScriptedGui('cm_gui_construct_upgrade').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('old_building_type', BuildingType.MakeScope).AddScope('new_building_type', BuildingType.GetNextReplacementBuilding(Player.Self).MakeScope).AddScope('country', GetPlayer.MakeScope).End)]"
								}
							}
						}
					}
				}
			}
		}
	}
}
