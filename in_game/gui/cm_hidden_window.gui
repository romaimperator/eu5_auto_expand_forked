# Always-present hidden window that classifies every building type once per lobby. Engine bindings like
# IsProducing and GetNextReplacementBuilding read only in GUI, so classification runs here and writes
# maps that script reads.
widget = {
	name = "cm_hidden_window"
	# Keeps descendant visibility gates re-evaluating each frame.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	position = { -10000 1 }
	widget = {
		# Classification driver. Demand before produced because cm_produced_good reads the demand maps;
		# rgob scan before collect because collect reads the scan maps; init last because its completion
		# branch sweeps the collect data.
		# visible_at_creation = no pins it hidden at creation so a loaded save (gate already true when the
		# window builds) still gets a hidden->shown first-show that fires _show.
		widget = {
			size = { 0 0 }
			visible_at_creation = no
			visible = "[And(GetPlayer.Exists, GetScriptedGui('cm_should_building_type_section_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('cm_country', GetPlayer.MakeScope).End))]"
			state = {
				name = _show
				duration = 0.5
				next = cm_building_type_pass_produced
				on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_buildings_construction_demand_state')]"
			}
			state = {
				name = cm_building_type_pass_produced
				duration = 0.5
				next = cm_building_type_pass_rgob_scan
				on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_produced_good_state')]"
			}
			state = {
				name = cm_building_type_pass_rgob_scan
				duration = 0.5
				next = cm_building_type_pass_rgob_collect
				on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_rgob_scan_state')]"
			}
			state = {
				name = cm_building_type_pass_rgob_collect
				duration = 0.5
				next = cm_building_type_pass_init
				on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_rgob_collect_state')]"
			}
			state = {
				name = cm_building_type_pass_init
				duration = 0.5
				on_finish = "[PdxGuiTriggerAllAnimations('cm_building_type_section_buildings_init_state')]"
			}
		}

		# Statically visible so each type's nested demand/produced sub-datamodels instantiate before the driver fires the passes.
		widget = {
			datamodel = "[GetGlobalList('cm_building_types_to_process')]"
			item = {
				hbox = {
					datacontext = "[Scope.GetBuildingType]"
					state = {
						name = cm_building_type_section_buildings_init_state
						on_finish = "[GetScriptedGui('cm_building_type_section_buildings_init').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_is_producing', MakeScopeBool(BuildingType.IsProducing)).AddScope('cm_is_multiple_levels', MakeScopeBool(BuildingType.IsMultipleLevels)).AddScope('cm_is_fort', MakeScopeBool(BuildingType.IsFort)).AddScope('cm_pop_type', BuildingType.GetPopType.MakeScope).AddScope('cm_upgrade_type', BuildingType.GetNextReplacementBuilding(Player.Self).MakeScope).End)]"
					}
					vbox = {
						margin = { 5 0 }
						visible = "[BuildingType.HasConstructionGoodsDemand]"
						datamodel = "[BuildingType.GetConstructionDemand.GetEntries]"
						item = {
							overlappingitembox = {
								state = {
									name = cm_building_type_section_buildings_construction_demand_state
									on_finish = "[GetScriptedGui('cm_construction_demand').Execute(GuiScope.AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_good', GoodsDemandEntry.GetGoods.MakeScope).AddScope('cm_amount', MakeScopeValue(GoodsDemandEntry.GetValue)).End)]"
								}
							}
						}
					}
					vbox = {
						visible = "[BuildingType.IsProducing]"
						datamodel = "[BuildingType.GetPossibleProductionMethods]"
						item = {
							vbox = {
								datamodel = "[PossibleProductionMethods.GetMethods]"
								item = {
									vbox = {
										visible = "[ProductionMethod.IsProducing]"
										widget = {
											state = {
												name = cm_building_type_section_produced_good_state
												on_finish = "[GetScriptedGui('cm_produced_good').Execute(GuiScope.AddScope('cm_building_type', BuildingType.MakeScope).AddScope('cm_produced_good', ProductionMethod.GetProduced.MakeScope).End)]"
											}
											state = {
												name = cm_building_type_section_rgob_scan_state
												on_finish = "[GetScriptedGui('cm_rgob_scan_pm').Execute(GuiScope.AddScope('cm_rgob_bt', BuildingType.MakeScope).AddScope('cm_rgob_out', MakeScopeValue(ProductionMethod.GetOutput)).End)]"
											}
											state = {
												name = cm_building_type_section_rgob_collect_state
												on_finish = "[GetScriptedGui('cm_rgob_collect_pm').Execute(GuiScope.AddScope('cm_rgob_bt', BuildingType.MakeScope).AddScope('cm_rgob_pm', ProductionMethod.MakeScope).AddScope('cm_rgob_out', MakeScopeValue(ProductionMethod.GetOutput)).End)]"
											}
										}
										vbox = {
											datamodel = "[ProductionMethod.GetGoodsDemand.GetEntries]"
											item = {
												widget = {
													state = {
														name = cm_building_type_section_rgob_scan_state
														on_finish = "[GetScriptedGui('cm_rgob_scan_entry').Execute(GuiScope.AddScope('cm_rgob_bt', BuildingType.MakeScope).AddScope('cm_rgob_pm', ProductionMethod.MakeScope).AddScope('cm_rgob_amount', MakeScopeValue(GoodsDemandEntry.GetValue)).End)]"
													}
													state = {
														name = cm_building_type_section_rgob_collect_state
														on_finish = "[GetScriptedGui('cm_rgob_collect_entry').Execute(GuiScope.AddScope('cm_rgob_bt', BuildingType.MakeScope).AddScope('cm_rgob_pm', ProductionMethod.MakeScope).AddScope('cm_rgob_out', MakeScopeValue(ProductionMethod.GetOutput)).AddScope('cm_rgob_good', GoodsDemandEntry.GetGoods.MakeScope).AddScope('cm_rgob_amount', MakeScopeValue(GoodsDemandEntry.GetValue)).End)]"
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
