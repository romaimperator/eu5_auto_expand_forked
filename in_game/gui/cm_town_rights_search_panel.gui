# Urban right search panel: shown while the recommended urban rights mapmode
# family is active, overlaying the vanilla current-mapmode banner
# (mapmode_current_button). The best-rights button plus one search button per
# royal right and a close button; hovering previews the mode, clicking sets it.

# Strip offsets from screen bottom-center, one pair per mapmodes bar state,
# aligning the strip over the banner's two placements.
@cm_trmm_collapsed_x = 0
@cm_trmm_collapsed_y = -43
@cm_trmm_expanded_x = 0
@cm_trmm_expanded_y = -88

types cm_town_rights_search_panel_types {
	type cm_trmm_search_strip = hbox {
		spacing = 4
		margin = { 8 4 }

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_best_town_right')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_best_town_right')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_tooling')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_tooling')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_jewelry')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_jewelry')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_naval')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_naval')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_textile')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_textile')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_weaponry')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_weaponry')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_book')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_book')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_artisan')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_artisan')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_brewing')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_brewing')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_masonry')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_masonry')]"
		}

		# Same close action as right-clicking the vanilla banner.
		button_close = {
			blockoverride "close_properties" {}
			blockoverride "close_on_action" {
				on_action = "[SetDefaultMapMode]"
			}
			tooltip = "MAPMODE_SELECT_DEFAULT"
		}
	}
}

widget = {
	name = "cm_town_rights_search_panel"
	size = { 100% 100% }
	alwaystransparent = yes
	# Keeps the descendant visibility gates re-evaluating each frame.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	layer = top

	# Collapsed mapmodes bar placement.
	widget = {
		parentanchor = hcenter|bottom
		widgetanchor = hcenter|bottom
		position = { @cm_trmm_collapsed_x @cm_trmm_collapsed_y }
		# 10 buttons at 40 wide plus the close button, spacing, and margins.
		size = { 480 48 }
		alwaystransparent = no
		using = bg_paper_card
		visible = "[And3(GetPlayer.Exists, Or(Or5(GetMapMode('cm_best_town_right').IsActive, GetMapMode('cm_trmm_search_tooling').IsActive, GetMapMode('cm_trmm_search_jewelry').IsActive, GetMapMode('cm_trmm_search_naval').IsActive, GetMapMode('cm_trmm_search_textile').IsActive), Or5(GetMapMode('cm_trmm_search_weaponry').IsActive, GetMapMode('cm_trmm_search_book').IsActive, GetMapMode('cm_trmm_search_artisan').IsActive, GetMapMode('cm_trmm_search_brewing').IsActive, GetMapMode('cm_trmm_search_masonry').IsActive)), Not(Or3(MapModeSelectorVars.Exists('hover'), MapModeSelectorVars.Exists('action'), IsMapModeMenuPinned)))]"

		cm_trmm_search_strip = {}
	}

	# Expanded mapmodes bar placement: the banner rides above the selector
	# window, hidden while its tab picker is open.
	widget = {
		parentanchor = hcenter|bottom
		widgetanchor = hcenter|bottom
		position = { @cm_trmm_expanded_x @cm_trmm_expanded_y }
		size = { 480 48 }
		alwaystransparent = no
		using = bg_paper_card
		visible = "[And4(GetPlayer.Exists, Or(Or5(GetMapMode('cm_best_town_right').IsActive, GetMapMode('cm_trmm_search_tooling').IsActive, GetMapMode('cm_trmm_search_jewelry').IsActive, GetMapMode('cm_trmm_search_naval').IsActive, GetMapMode('cm_trmm_search_textile').IsActive), Or5(GetMapMode('cm_trmm_search_weaponry').IsActive, GetMapMode('cm_trmm_search_book').IsActive, GetMapMode('cm_trmm_search_artisan').IsActive, GetMapMode('cm_trmm_search_brewing').IsActive, GetMapMode('cm_trmm_search_masonry').IsActive)), Or3(MapModeSelectorVars.Exists('hover'), MapModeSelectorVars.Exists('action'), IsMapModeMenuPinned), Not(MapModeSelectorVars.Exists('tab')))]"

		cm_trmm_search_strip = {}
	}

	# Selection memory: cm_trmm_sel holds the last set family mode, and an
	# outside open of cm_best_town_right swaps once to it. cm_trmm_in marks
	# being inside the family, which keeps strip picks of best-rights from
	# re-triggering the swap. IsSet ignores the hover-preview overrides.

	# Open-swap drivers, one per search.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.HasValue('cm_trmm_sel', 'cm_trmm_search_tooling'), Not(GetVariableSystem.Exists('cm_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('cm_trmm_search_tooling').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.HasValue('cm_trmm_sel', 'cm_trmm_search_jewelry'), Not(GetVariableSystem.Exists('cm_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('cm_trmm_search_jewelry').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.HasValue('cm_trmm_sel', 'cm_trmm_search_naval'), Not(GetVariableSystem.Exists('cm_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('cm_trmm_search_naval').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.HasValue('cm_trmm_sel', 'cm_trmm_search_textile'), Not(GetVariableSystem.Exists('cm_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('cm_trmm_search_textile').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.HasValue('cm_trmm_sel', 'cm_trmm_search_weaponry'), Not(GetVariableSystem.Exists('cm_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('cm_trmm_search_weaponry').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.HasValue('cm_trmm_sel', 'cm_trmm_search_book'), Not(GetVariableSystem.Exists('cm_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('cm_trmm_search_book').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.HasValue('cm_trmm_sel', 'cm_trmm_search_artisan'), Not(GetVariableSystem.Exists('cm_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('cm_trmm_search_artisan').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.HasValue('cm_trmm_sel', 'cm_trmm_search_brewing'), Not(GetVariableSystem.Exists('cm_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('cm_trmm_search_brewing').SetMapMode]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And3(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.HasValue('cm_trmm_sel', 'cm_trmm_search_masonry'), Not(GetVariableSystem.Exists('cm_trmm_in')))]"
		state = {
			name = _show
			on_start = "[GetMapMode('cm_trmm_search_masonry').SetMapMode]"
		}
	}

	# Selection recorders.
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('cm_trmm_search_tooling').IsSet]"
		state = {
			name = _show
			# Delayed so the entry frame's swap check still sees the mark absent.
			duration = 0.2
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_trmm_search_tooling')]"
			on_finish = "[GetVariableSystem.Set('cm_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('cm_trmm_search_jewelry').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_trmm_search_jewelry')]"
			on_finish = "[GetVariableSystem.Set('cm_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('cm_trmm_search_naval').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_trmm_search_naval')]"
			on_finish = "[GetVariableSystem.Set('cm_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('cm_trmm_search_textile').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_trmm_search_textile')]"
			on_finish = "[GetVariableSystem.Set('cm_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('cm_trmm_search_weaponry').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_trmm_search_weaponry')]"
			on_finish = "[GetVariableSystem.Set('cm_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('cm_trmm_search_book').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_trmm_search_book')]"
			on_finish = "[GetVariableSystem.Set('cm_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('cm_trmm_search_artisan').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_trmm_search_artisan')]"
			on_finish = "[GetVariableSystem.Set('cm_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('cm_trmm_search_brewing').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_trmm_search_brewing')]"
			on_finish = "[GetVariableSystem.Set('cm_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[GetMapMode('cm_trmm_search_masonry').IsSet]"
		state = {
			name = _show
			duration = 0.2
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_trmm_search_masonry')]"
			on_finish = "[GetVariableSystem.Set('cm_trmm_in', 'on')]"
		}
	}
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetMapMode('cm_best_town_right').IsSet, GetVariableSystem.Exists('cm_trmm_in'))]"
		state = {
			name = _show
			on_start = "[GetVariableSystem.Set('cm_trmm_sel', 'cm_best_town_right')]"
		}
	}

	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[Not(Or(Or5(GetMapMode('cm_best_town_right').IsSet, GetMapMode('cm_trmm_search_tooling').IsSet, GetMapMode('cm_trmm_search_jewelry').IsSet, GetMapMode('cm_trmm_search_naval').IsSet, GetMapMode('cm_trmm_search_textile').IsSet), Or5(GetMapMode('cm_trmm_search_weaponry').IsSet, GetMapMode('cm_trmm_search_book').IsSet, GetMapMode('cm_trmm_search_artisan').IsSet, GetMapMode('cm_trmm_search_brewing').IsSet, GetMapMode('cm_trmm_search_masonry').IsSet)))]"
		state = {
			name = _show
			on_start = "[GetVariableSystem.Clear('cm_trmm_in')]"
		}
	}
}
