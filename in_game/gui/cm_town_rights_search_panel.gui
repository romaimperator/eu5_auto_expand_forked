# Urban right search panel: shown while the recommended urban rights map mode
# family is active, overlaying the vanilla current-map-mode banner
# (mapmode_current_button). The best-rights button plus one search button per
# royal right and a close button; hovering previews the mode, clicking sets it.

# Strip offsets from screen bottom-center, one pair per map-modes bar state,
# aligning the strip over the banner's two placements.
@cm_trmm_collapsed_x = 0
@cm_trmm_collapsed_y = -43
@cm_trmm_expanded_x = 0
@cm_trmm_expanded_y = -88

types cm_town_rights_search_panel_types {
	type cm_trmm_search_strip = hbox {
		spacing = 4
		margin = { 8 4 }

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_best_town_right')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_best_town_right')]"
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_tooling')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_tooling')]"
			icon = {
				size = { 75% 75% }
				parentanchor = center
				texture = "gfx/interface/icons/town_rights/royal_tooling_rights.dds"
			}
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_jewelry')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_jewelry')]"
			icon = {
				size = { 75% 75% }
				parentanchor = center
				texture = "gfx/interface/icons/town_rights/royal_jewelry_rights.dds"
			}
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_naval')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_naval')]"
			icon = {
				size = { 75% 75% }
				parentanchor = center
				texture = "gfx/interface/icons/town_rights/royal_naval_rights.dds"
			}
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_textile')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_textile')]"
			icon = {
				size = { 75% 75% }
				parentanchor = center
				texture = "gfx/interface/icons/town_rights/royal_textile_rights.dds"
			}
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_weaponry')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_weaponry')]"
			icon = {
				size = { 75% 75% }
				parentanchor = center
				texture = "gfx/interface/icons/town_rights/royal_weaponry_rights.dds"
			}
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_book')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_book')]"
			icon = {
				size = { 75% 75% }
				parentanchor = center
				texture = "gfx/interface/icons/town_rights/royal_book_rights.dds"
			}
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_artisan')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_artisan')]"
			icon = {
				size = { 75% 75% }
				parentanchor = center
				texture = "gfx/interface/icons/town_rights/royal_artisan_rights.dds"
			}
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_brewing')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_brewing')]"
			icon = {
				size = { 75% 75% }
				parentanchor = center
				texture = "gfx/interface/icons/town_rights/royal_brewing_rights.dds"
			}
		}

		mapmode_tooltip_button = {
			datacontext = "[GetMapMode('cm_trmm_search_masonry')]"
			onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('cm_trmm_search_masonry')]"
			icon = {
				size = { 75% 75% }
				parentanchor = center
				texture = "gfx/interface/icons/town_rights/royal_masonry_rights.dds"
			}
		}

		# Same close action as right-clicking the vanilla banner.
		button_close = {
			blockoverride "close_properties" {}
			blockoverride "close_on_action" {
				on_action = "[SetDefaultMapMode]"
			}
			tooltip = "MAPMODE_SELECT_DEFAULT"
		}
	}
}

widget = {
	name = "cm_town_rights_search_panel"
	size = { 100% 100% }
	alwaystransparent = yes
	# Keeps the descendant visibility gates re-evaluating each frame.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	layer = top

	# Collapsed map-modes bar placement.
	widget = {
		parentanchor = hcenter|bottom
		widgetanchor = hcenter|bottom
		position = { @cm_trmm_collapsed_x @cm_trmm_collapsed_y }
		# 10 buttons at 40 wide plus the close button, spacing, and margins.
		size = { 480 48 }
		alwaystransparent = no
		using = bg_paper_card
		visible = "[And3(GetPlayer.Exists, Or(Or5(GetMapMode('cm_best_town_right').IsActive, GetMapMode('cm_trmm_search_tooling').IsActive, GetMapMode('cm_trmm_search_jewelry').IsActive, GetMapMode('cm_trmm_search_naval').IsActive, GetMapMode('cm_trmm_search_textile').IsActive), Or5(GetMapMode('cm_trmm_search_weaponry').IsActive, GetMapMode('cm_trmm_search_book').IsActive, GetMapMode('cm_trmm_search_artisan').IsActive, GetMapMode('cm_trmm_search_brewing').IsActive, GetMapMode('cm_trmm_search_masonry').IsActive)), Not(Or3(MapModeSelectorVars.Exists('hover'), MapModeSelectorVars.Exists('action'), IsMapModeMenuPinned)))]"

		cm_trmm_search_strip = {}
	}

	# Expanded map-modes bar placement: the banner rides above the selector
	# window, hidden while its tab picker is open.
	widget = {
		parentanchor = hcenter|bottom
		widgetanchor = hcenter|bottom
		position = { @cm_trmm_expanded_x @cm_trmm_expanded_y }
		size = { 480 48 }
		alwaystransparent = no
		using = bg_paper_card
		visible = "[And4(GetPlayer.Exists, Or(Or5(GetMapMode('cm_best_town_right').IsActive, GetMapMode('cm_trmm_search_tooling').IsActive, GetMapMode('cm_trmm_search_jewelry').IsActive, GetMapMode('cm_trmm_search_naval').IsActive, GetMapMode('cm_trmm_search_textile').IsActive), Or5(GetMapMode('cm_trmm_search_weaponry').IsActive, GetMapMode('cm_trmm_search_book').IsActive, GetMapMode('cm_trmm_search_artisan').IsActive, GetMapMode('cm_trmm_search_brewing').IsActive, GetMapMode('cm_trmm_search_masonry').IsActive)), Or3(MapModeSelectorVars.Exists('hover'), MapModeSelectorVars.Exists('action'), IsMapModeMenuPinned), Not(MapModeSelectorVars.Exists('tab')))]"

		cm_trmm_search_strip = {}
	}
}
