types cm_auto_food {
	# Auto-food tooltip title icon.
	type cm_auto_food_checkbutton = checkbutton {
		texture = "gfx/interface/icons/location_icons/food.dds"
		texture_density = 2
		frame_grid = { 1 1 }
		size = { 30 30 }
	}

	# Used for the location window in location_window.gui: sits above the cm_auto_expand_rgo widget.
	type cm_auto_food_widget_location_window = cm_auto_food_widget {
		parentanchor = bottom|right
		# Flush against each other:
		# size = { 19 19 }
		# position = { -2 -20 }
		# Medium separated:
		size = { 18 18 }
		position = { -2 -22 }
		# Smaller separated:
		# size = { 16 16 }
		# position = { -2 -24 }
	}

	# Used for the food production lateralview in food_production_lateralview.gui.
	type cm_auto_food_widget_food_production_lateralview = cm_auto_food_widget {
	}

	type cm_auto_food_widget = widget {
		visible = "[And(ObjectsEqual(Location.GetOwner, GetPlayer), GetScriptedGui('cm_is_food_rgo_location').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
		size = { 20 20 }

		button_square_checkbox = {
			size = { 100% 100% }
			background = {
				texture = "gfx/interface/buttons/cm_glow_square.dds"
				texture_density = 2
				glow = {
					name = "green_glow"
					glow_radius = 5
					color = { 0.0 1.0 0.0 0.9 }
					alpha = 0.6
					block "green_glow_visible" { visible = "[And(GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End), GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]" }
				}
			}
			background = {
				texture = "gfx/interface/buttons/cm_glow_square.dds"
				texture_density = 2
				glow = {
					name = "red_glow"
					glow_radius = 5
					color = { 1.0 0.0 0.0 0.9 }
					alpha = 0.6
					block "red_glow_visible" { visible = "[And(GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)))]" }
				}
			}
			background = {
				texture = "gfx/interface/buttons/checkbox_bg_square.dds"
				texture_density = 2
				modify_texture = { using = color_black_texture blend_mode = multiply }
			}
			parentanchor = center
			widgetanchor = center
			enabled = "[ObjectsEqual(Location.GetOwner, GetPlayer)]"
			tooltipwidget = { using = cm_Autofood_Tooltip }

			blockoverride "check_texture" {
				texture = "gfx/interface/icons/location_icons/food.dds"
			}
			blockoverride "checked_visible" {
				visible = "[GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
			}
			blockoverride "unchecked_visible" {
				visible = "[Not(GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
			}

			action_tooltip = {
				click_type = left
				click_mode = single
				click_modifier = default
				title = "CM_AUTO_FOOD_TOGGLE"
				on_action = "[GetScriptedGui('cm_set_auto_food_for_location').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
				on_action = "[GetMapMode('cm_location_food_potential_hidden').SetMapMode]"
				on_action = "[PdxGuiWidget.TriggerAnimation('cm_swap_map_mode_state')]"
			}
			state = {
				name = cm_swap_map_mode_state
				duration = 0.1
				on_finish = "[GetMapMode('cm_location_food_potential').SetMapMode]"
			}
			using = cm_rightclick_open_settings_window
		}
	}
}

template cm_Autofood_Tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			cm_auto_food_checkbutton = {
				using = tooltip_title_icon_size
				tooltip_enabled = no
				checked = "[GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
				enabled = yes
			}
		}

		blockoverride "title_text" {
			text = "CM_AUTO_FOOD_TT_TITLE"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "CM_AUTO_FOOD_TOOLTIP_DESC"
				}
			}

			TooltipTextBlock = {
				visible = "[GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_ALL_REQUIREMENTS_MET"
				}
			}
			TooltipListBase = {
				visible = "[Not(GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
				blockoverride "block_title" {
					text = "CM_AUTO_FOOD_REQ_HEADER"
				}
				TooltipListRowContent = {
					cm_tooltip_row = {
						visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "first_element" { visible = yes }
						blockoverride "not_first_element" { visible = no }
						blockoverride "yes_visible" {
							visible = "[Not(GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "no_visible" {
							visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_EXPAND_REQ_NOT_PAUSED"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_auto_food_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_auto_food_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_auto_food_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_FOOD_REQ_ENABLED"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_food_location_has_market_access').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_has_market_access').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_has_market_access').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_FOOD_REQ_MARKET_ACCESS"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_food_location_pops_not_still_filling').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_pops_not_still_filling').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_pops_not_still_filling').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_FOOD_REQ_POPS"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_food_location_has_buildable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_has_buildable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_has_buildable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_FOOD_REQ_BUILDABLE"
						}
					}
					cm_tooltip_row = {
						visible = "[And(GetScriptedGui('cm_food_location_has_buildable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End), Not(GetScriptedGui('cm_food_location_has_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_has_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_has_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_FOOD_REQ_DISCOUNT"
						}
					}
					cm_tooltip_row = {
						visible = "[And(GetScriptedGui('cm_food_location_has_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End), Not(GetScriptedGui('cm_food_location_has_viable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_has_viable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_has_viable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_FOOD_REQ_GOLD"
						}
					}
					cm_tooltip_row = {
						visible = "[And(GetScriptedGui('cm_food_location_has_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End), Not(GetScriptedGui('cm_food_location_has_unshortaged_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_has_unshortaged_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_has_unshortaged_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							text = "CM_AUTO_FOOD_REQ_MARKET_GOODS"
						}
					}
				}
			}

			TooltipTextBlock = {
				visible = "[And(GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('cm_food_good', Location.GetRawMaterial.MakeScope).AddScope('cm_country', Location.GetOwner.MakeScope).AddScope('cm_location', Location.MakeScope).End)))]"
				blockoverride "text" {
					text = "CM_AUTO_FOOD_WILL_NOT_BUILD"
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_red_texture
					}
				}
			}
		}

		blockoverride "tooltip_ui_action_block" {
			TooltipFunctionalBlock = {
				using = tooltip_left_right_click_template
				blockoverride "action_left_text" {
					text = "CM_AUTO_FOOD_TOGGLE"
				}
				blockoverride "action_right_text" {
					text = "CM_OPEN_SETTINGS"
				}
			}
		}
	}
}
