types cm_auto_food {
	# Food variant of cm_auto_expand_checkbutton. Points at checkbox_auto_food.dds so the food icon
	# can be edited independently.
	type cm_auto_food_checkbutton = checkbutton {
		texture = "gfx/interface/buttons/checkbox_auto_food.dds"
		texture_density = 2
		frame_grid = { 2 1 }
		size = { 30 30 }

		background = {
			texture = "gfx/interface/buttons/checkbox_bg.dds"
			texture_density = 2
			using = color_dark_blue
			glow = {
				name = "green_glow"
				glow_radius = 5
				alpha = 1.0
				color = {0.0 1.0 0.0 1.0} # green
				block "green_glow_visible" { visible = no }
			}
		}
		background = {
			texture = "gfx/interface/buttons/checkbox_bg.dds"
			texture_density = 2
			using = color_dark_blue
			glow = {
				name = "red_glow"
				glow_radius = 5
				alpha = 1.0
				color = {1.0 0.0 0.0 1.0} # red
				block "red_glow_visible" { visible = no }
			}
		}
	}

	# Used for location window (location_window.gui): sits above the auto_expand_rgo widget.
	type cm_auto_food_widget_location_window = cm_auto_food_widget {
		parentanchor = bottom|right
		position = { 2 -21 }
	}

	# Used for the food production lateralview (food_production_lateralview.gui).
	type cm_auto_food_widget_food_production_lateralview = cm_auto_food_widget {
	}

	type cm_auto_food_widget = widget {
		visible = "[And(ObjectsEqual(Location.GetOwner, GetPlayer), GetScriptedGui('cm_is_food_rgo_location').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
		size = { 23 23 }

		button = {
			size = { 100% 100% }
			enabled = "[ObjectsEqual(Location.GetOwner, GetPlayer)]"
			tooltipwidget = {
				using = cm_Autofood_Tooltip
			}

			action_tooltip = {
				click_type = left
				click_mode = single
				click_modifier = default
				title = "CM_AUTO_FOOD_TOGGLE"
				on_action = "[GetScriptedGui('cm_set_auto_food_for_location').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)]"
				on_action = "[GetMapMode('cm_location_food_potential_hidden').SetMapMode]"
				on_action = "[PdxGuiWidget.TriggerAnimation('cm_swap_map_mode_state')]"
			}
			state = {
				name = cm_swap_map_mode_state
				duration = 0.1
				on_finish = "[GetMapMode('cm_location_food_potential').SetMapMode]"
			}
			using = cm_rightclick_open_settings_window

			cm_auto_food_checkbutton = {
				size = { 100% 100% }
				alwaystransparent = yes
				tooltip_enabled = no
				checked = "[GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)]"
				blockoverride "green_glow_visible" {
					visible = "[And(GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End), GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End))]"
				}
				blockoverride "red_glow_visible" {
					visible = "[And(GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)))]"
				}
			}
		}
	}
}

template cm_Autofood_Tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			cm_auto_food_checkbutton = {
				using = tooltip_title_icon_size
				tooltip_enabled = no
				checked = "[GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)]"
				enabled = yes
			}
		}

		blockoverride "title_text" {
			raw_text = "Food Auto-Build"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "CM_AUTO_FOOD_TOOLTIP_DESC"
				}
			}

			TooltipTextBlock = {
				visible = "[GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)]"
				blockoverride "text" {
					text = "CM_AUTO_EXPAND_ALL_REQUIREMENTS_MET"
				}
			}
			TooltipListBase = {
				visible = "[Not(GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End))]"
				blockoverride "block_title" {
					raw_text = "Cannot build food until the following requirements are met:"
				}
				TooltipListRowContent = {
					cm_tooltip_row = {
						visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						blockoverride "first_element" { visible = yes }
						blockoverride "not_first_element" { visible = no }
						blockoverride "yes_visible" {
							visible = "[Not(GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "no_visible" {
							visible = "[GetScriptedGui('cm_pause_auto_expand').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "row_text" {
							raw_text = "Auto-expand is not paused"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_is_auto_food_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_is_auto_food_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_is_auto_food_feature_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "Food auto-build feature is enabled"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_food_location_has_market_access').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_has_market_access').IsShown(GuiScope.SetRoot(Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_has_market_access').IsShown(GuiScope.SetRoot(Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "Location has market access"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_food_location_pops_not_still_filling').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_pops_not_still_filling').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_pops_not_still_filling').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "Location has pops available for at least one food building"
						}
					}
					cm_tooltip_row = {
						visible = "[Not(GetScriptedGui('cm_food_location_has_buildable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_has_buildable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_has_buildable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "At least one food building can be built here"
						}
					}
					cm_tooltip_row = {
						visible = "[And(GetScriptedGui('cm_food_location_has_buildable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End), Not(GetScriptedGui('cm_food_location_has_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)))]"
						using = cm_tooltip_row_is_odd
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_has_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_has_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "At least one food building meets the minimum construction discount"
						}
					}
					cm_tooltip_row = {
						visible = "[And(GetScriptedGui('cm_food_location_has_discounted_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End), Not(GetScriptedGui('cm_food_location_has_viable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)))]"
						blockoverride "yes_visible" {
							visible = "[GetScriptedGui('cm_food_location_has_viable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)]"
						}
						blockoverride "no_visible" {
							visible = "[Not(GetScriptedGui('cm_food_location_has_viable_option').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End))]"
						}
						blockoverride "row_text" {
							raw_text = "Enough gold to build food while keeping the Gold Reserve"
						}
					}
				}
			}

			TooltipTextBlock = {
				visible = "[And(GetScriptedGui('cm_set_auto_food_for_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End), Not(GetScriptedGui('cm_is_able_to_auto_food_location').IsShown(GuiScope.SetRoot(Location.MakeScope).AddScope('food_good', Location.GetRawMaterial.MakeScope).AddScope('country', Location.GetOwner.MakeScope).AddScope('location', Location.MakeScope).End)))]"
				blockoverride "text" {
					raw_text = "Food will not build; conditions are not met"
				}
				blockoverride "textblock_background_tint"  {
					modify_texture = {
						using = color_red_texture
					}
				}
			}
		}

		blockoverride "tooltip_ui_action_block" {
			TooltipFunctionalBlock = {
				using = tooltip_left_right_click_template
				blockoverride "action_left_text" {
					raw_text = "Toggle Auto-Food"
				}
				blockoverride "action_right_text" {
					raw_text = "Open Settings"
				}
			}
		}
	}
}
