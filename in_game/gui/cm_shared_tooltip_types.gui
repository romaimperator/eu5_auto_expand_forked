@tooltip_inner_margin = 10
types cm_shared_tooltip_types {
  type CMTooltipTextBlockContainer = TooltipListBase {
    vbox = {
      layoutpolicy_horizontal = expanding
      margin = { @tooltip_inner_margin @tooltip_inner_margin }

      block "text_content" {
        CMTooltipTextBox = {}
      }
    }
  }

  type CMTooltipTextBox = textbox {
    using = tooltip_text_block_template

    block "text" {
      raw_text = " "
    }
  }
}
