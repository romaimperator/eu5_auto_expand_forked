### Construction Manager migration prompt.
### Offers to enable Construction Manager (Workshop 3736668860), or opens the
### Workshop to find it, then disables this mod once Construction Manager is active.
types lsq_construction_manager_migration
{
	### Main-menu overlay: migration popup plus the mods-panel opener.
	type lsq_migration_overlay = widget {
		size = { 100% 100% }

		### Migration prompt
		widget = {
			size = { 100% 100% }
			parentanchor = center
			alwaystransparent = no

			visible = "[And( Not( GetVariableSystem.Exists( 'lsq_migrate_new_active' ) ), Not( GetVariableSystem.Exists( 'lsq_migrate_dismiss' ) ) )]"

			window = {
				parentanchor = center
				widgetanchor = center
				size = { 530 250 }
				using = bg_window_default_alt
				movable = no
				resizable = no
				alwaystransparent = no

				vbox = {
					margin = { 0 10 }
					spacing = 5

					text_single = {
						raw_text = "[SelectLocalization(HasLanguage('french'), '#T Nouvelle version disponible#!', SelectLocalization(HasLanguage('german'), '#T Neue Version verfügbar#!', SelectLocalization(HasLanguage('spanish'), '#T Nueva versión disponible#!', SelectLocalization(HasLanguage('braz_por'), '#T Nova versão disponível#!', SelectLocalization(HasLanguage('russian'), '#T Доступна новая версия#!', SelectLocalization(HasLanguage('polish'), '#T Dostępna nowa wersja#!', SelectLocalization(HasLanguage('korean'), '#T 새 버전 사용 가능#!', SelectLocalization(HasLanguage('japanese'), '#T 新しいバージョンが利用可能#!', SelectLocalization(HasLanguage('simp_chinese'), '#T 有新版本可用#!', SelectLocalization(HasLanguage('turkish'), '#T Yeni sürüm mevcut#!', '#T New Version Available#!'))))))))))]"
						align = center
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						raw_text = "[SelectLocalization(HasLanguage('french'), '#bold Construction Manager#! a remplacé Location Specialization QoL (Auto-Expand).', SelectLocalization(HasLanguage('german'), '#bold Construction Manager#! hat Location Specialization QoL (Auto-Expand) ersetzt.', SelectLocalization(HasLanguage('spanish'), '#bold Construction Manager#! ha reemplazado a Location Specialization QoL (Auto-Expand).', SelectLocalization(HasLanguage('braz_por'), '#bold Construction Manager#! substituiu Location Specialization QoL (Auto-Expand).', SelectLocalization(HasLanguage('russian'), '#bold Construction Manager#! заменил Location Specialization QoL (Auto-Expand).', SelectLocalization(HasLanguage('polish'), '#bold Construction Manager#! zastąpił Location Specialization QoL (Auto-Expand).', SelectLocalization(HasLanguage('korean'), '#bold Construction Manager#!가 Location Specialization QoL (Auto-Expand)를 대체했습니다.', SelectLocalization(HasLanguage('japanese'), '#bold Construction Manager#!がLocation Specialization QoL (Auto-Expand)に取って代わりました。', SelectLocalization(HasLanguage('simp_chinese'), '#bold Construction Manager#! 已取代 Location Specialization QoL (Auto-Expand)。', SelectLocalization(HasLanguage('turkish'), '#bold Construction Manager#!, Location Specialization QoL (Auto-Expand) modunun yerini aldı.', '#bold Construction Manager#! has replaced Location Specialization QoL (Auto-Expand).'))))))))))]"
						align = center
						autoresize = yes
						max_width = 500
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						raw_text = "[SelectLocalization(HasLanguage('french'), 'Il est recommandé de passer à la nouvelle version, qui est un remplacement direct avec de nombreuses nouvelles fonctionnalités.', SelectLocalization(HasLanguage('german'), 'Es wird empfohlen, zur neuen Version zu wechseln, die ein direkter Ersatz mit vielen neuen Funktionen ist.', SelectLocalization(HasLanguage('spanish'), 'Se recomienda cambiar a la nueva versión, que es un reemplazo directo con muchas funciones nuevas.', SelectLocalization(HasLanguage('braz_por'), 'Recomenda-se mudar para a nova versão, que é uma substituição direta com muitos recursos novos.', SelectLocalization(HasLanguage('russian'), 'Рекомендуется перейти на новую версию, которая представляет собой прямую замену с множеством новых функций.', SelectLocalization(HasLanguage('polish'), 'Zaleca się przejście na nową wersję, która jest bezpośrednim zamiennikiem z wieloma nowymi funkcjami.', SelectLocalization(HasLanguage('korean'), '많은 새로운 기능을 갖춘 직접 대체 모드이므로 새 버전으로 전환하는 것이 좋습니다.', SelectLocalization(HasLanguage('japanese'), '多くの新機能を備えた直接の置き換えであるため、新しいバージョンへの切り替えをおすすめします。', SelectLocalization(HasLanguage('simp_chinese'), '建议切换到新版本，它是一个直接替换版，拥有许多新功能。', SelectLocalization(HasLanguage('turkish'), 'Yeni sürüme geçmeniz önerilir; bu sürüm birçok yeni özelliğe sahip doğrudan bir alternatiftir.', 'It is recommended to switch to the new version, which is a drop-in replacement with many new features.'))))))))))]"
						align = center
						autoresize = yes
						max_width = 500
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						raw_text = "[SelectLocalization(HasLanguage('french'), 'Elle est entièrement compatible avec les sauvegardes et transférera vos paramètres existants vers le nouveau mod.', SelectLocalization(HasLanguage('german'), 'Sie ist vollständig mit Spielständen kompatibel und überträgt deine vorhandenen Einstellungen in den neuen Mod.', SelectLocalization(HasLanguage('spanish'), 'Es totalmente compatible con las partidas guardadas y transferirá tu configuración existente al nuevo mod.', SelectLocalization(HasLanguage('braz_por'), 'É totalmente compatível com saves e transferirá suas configurações existentes para o novo mod.', SelectLocalization(HasLanguage('russian'), 'Она полностью совместима с сохранениями и перенесёт ваши текущие настройки в новый мод.', SelectLocalization(HasLanguage('polish'), 'Jest w pełni zgodna z zapisami gry i przeniesie twoje istniejące ustawienia do nowego moda.', SelectLocalization(HasLanguage('korean'), '저장 게임과 완전히 호환되며 기존 설정을 새 모드로 옮겨 줍니다.', SelectLocalization(HasLanguage('japanese'), 'セーブデータと完全に互換性があり、既存の設定を新しいMODに引き継ぎます。', SelectLocalization(HasLanguage('simp_chinese'), '它完全兼容存档，并会将你现有的设置转移到新模组。', SelectLocalization(HasLanguage('turkish'), 'Kayıtlarla tamamen uyumludur ve mevcut ayarlarınızı yeni moda aktarır.', 'It is fully savegame-compatible and will transfer your existing settings to the new mod.'))))))))))]"
						align = center
						autoresize = yes
						max_width = 500
					}

					# expand = {}

					hbox = {
						spacing = 10
						ignoreinvisible = yes

						button_regular = {
							size = { 150 40 }
							raw_text = "[SelectLocalization(HasLanguage('french'), 'Ouvrir le Workshop', SelectLocalization(HasLanguage('german'), 'Workshop öffnen', SelectLocalization(HasLanguage('spanish'), 'Abrir taller', SelectLocalization(HasLanguage('braz_por'), 'Abrir oficina', SelectLocalization(HasLanguage('russian'), 'Открыть мастерскую', SelectLocalization(HasLanguage('polish'), 'Otwórz warsztat', SelectLocalization(HasLanguage('korean'), '창작마당 열기', SelectLocalization(HasLanguage('japanese'), 'ワークショップを開く', SelectLocalization(HasLanguage('simp_chinese'), '打开创意工坊', SelectLocalization(HasLanguage('turkish'), 'Atölyeyi aç', 'Open Workshop'))))))))))]"
							visible = "[Not( GetVariableSystem.Exists( 'lsq_migrate_installed' ) )]"
							onclick = "[GetVariableSystem.Set( 'lsq_migrate_open_workshop', 'yes' )]"
							onclick = "[GetVariableSystem.Set( 'lsq_migrate_enable', 'yes' )]"
							onclick = "[GetVariableSystem.Set( 'lsq_migrate_dismiss', 'yes' )]"
							tooltip_enabled = no
						}

						button_regular = {
							size = { 150 40 }
							raw_text = "[SelectLocalization(HasLanguage('french'), 'Activer', SelectLocalization(HasLanguage('german'), 'Aktivieren', SelectLocalization(HasLanguage('spanish'), 'Activar', SelectLocalization(HasLanguage('braz_por'), 'Ativar', SelectLocalization(HasLanguage('russian'), 'Включить', SelectLocalization(HasLanguage('polish'), 'Włącz', SelectLocalization(HasLanguage('korean'), '활성화', SelectLocalization(HasLanguage('japanese'), '有効にする', SelectLocalization(HasLanguage('simp_chinese'), '启用', SelectLocalization(HasLanguage('turkish'), 'Etkinleştir', 'Enable'))))))))))]"
							visible = "[GetVariableSystem.Exists( 'lsq_migrate_installed' )]"
							onclick = "[GetVariableSystem.Set( 'lsq_migrate_enable', 'yes' )]"
							onclick = "[GetVariableSystem.Set( 'lsq_migrate_open_mods', 'yes' )]"
							onclick = "[GetVariableSystem.Set( 'lsq_migrate_dismiss', 'yes' )]"
							tooltip_enabled = no
						}

						button_regular = {
							size = { 150 40 }
							raw_text = "[SelectLocalization(HasLanguage('french'), 'Ignorer', SelectLocalization(HasLanguage('german'), 'Ignorieren', SelectLocalization(HasLanguage('spanish'), 'Ignorar', SelectLocalization(HasLanguage('braz_por'), 'Ignorar', SelectLocalization(HasLanguage('russian'), 'Игнорировать', SelectLocalization(HasLanguage('polish'), 'Ignoruj', SelectLocalization(HasLanguage('korean'), '무시', SelectLocalization(HasLanguage('japanese'), '無視する', SelectLocalization(HasLanguage('simp_chinese'), '忽略', SelectLocalization(HasLanguage('turkish'), 'Yoksay', 'Ignore'))))))))))]"
							onclick = "[GetVariableSystem.Set( 'lsq_migrate_dismiss', 'yes' )]"
							tooltip_enabled = no
						}
					}
				}
			}
		}

		### Open the mods panel so playset_create_button instantiates and detection runs.
		widget = {
			size = { 0 0 }
			visible_at_creation = no
			visible = "[And3( Not( GetVariableSystem.Exists( 'lsq_migrate_new_active' ) ), Not( GetVariableSystem.Exists( 'lsq_migrate_dismiss' ) ), Not( FrontEndMainView.IsModsOpen ) )]"

			state = {
				name = _show
				on_start = "[FrontEndMainView.ToggleOpenMods]"
			}
		}

		### Open the mods panel when a button requests it.
		widget = {
			size = { 0 0 }
			visible_at_creation = no
			visible = "[And( Or( GetVariableSystem.Exists( 'lsq_migrate_open_mods' ), GetVariableSystem.Exists( 'lsq_migrate_open_workshop' ) ), Not( FrontEndMainView.IsModsOpen ) )]"

			state = {
				name = _show
				on_start = "[FrontEndMainView.ToggleOpenMods]"
				on_start = "[GetVariableSystem.Clear( 'lsq_migrate_open_mods' )]"
			}
		}
	}

	type FrontEndBackground = widget {
		size = { 100% 100% }

		background = {
			name = "frontend_bg"
			using = FrontEndBackgroundTexture
			size = { 100% 100% }
			fittype = centercrop
		}

		widget = {
			parentanchor = right
			block "logo_container" {}

			vbox = {
				resizeparent = yes
				margin = { 10 10 }
				spacing = 10

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 10

					expand = {}

					icon = {
						texture = "gfx/interface/logos/clausewitz_logo.dds"
						size = { 100 100 }
					}

					icon = {
						texture = "gfx/interface/logos/pdx_tinto_logo_white.dds"
						size = { 100 100 }
					}
				}

				vbox = {
					using = version_label
					blockoverride "version_label_sizing" {}
					blockoverride "version_label_background" {
						using = VersionLabelBackground
					}
				}
			}
		}

		lsq_migration_overlay = {}
	}
}

### Detection and playset actions. Lives in playset_create_button so it only
### instantiates while the mods panel is open.
types lsq_construction_manager_auto_enable
{
	type playset_create_button = vbox {
		layoutpolicy_horizontal = expanding

		### Create-playset row
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			margin = {10 0}

			editbox_single = {
				name = "create_playset_editbox"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = fixed
				tooltipwidget = {
					LeftClickButtonTooltip = {
						blockoverride "onclick_text" {
							text = "MODS_GUI_PLAYSET_LABEL_TOOLTIP"
						}
					}
				}

				blockoverride "editbox_label" {
					text = "MODS_GUI_PLAYSET_LABEL"
				}
			}

			button_regular = {
				text = "MODS_GUI_CREATE_PLAYSET"
				tooltipwidget = {BasicFunctionalTooltip = {}}

				action_tooltip = {
					click_type = left
					click_mode = single
					title = "[ModsGui.CreatePlaysetTooltip(PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox')))]"
					on_action = "[ModsGui.CreatePlayset(PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox')))]"
					on_action = "[PdxClearEditBoxText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox'))]"
					enabled = "[ModsGui.CanCreatePlayset(PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox')))]"
				}
				enabled = "[ModsGui.CanCreatePlayset(PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('create_playset_editbox')))]"
				align = center|nobaseline
				using = button_resize_to_fit_text
			}
		}

		### Construction Manager subscribed
		vbox = {
			datamodel = "[ModsGui.LocalMods]"

			item = {
				widget = {
					size = { 0 0 }
					visible_at_creation = no
					visible = "[StringContains( LocalMod.Path, '3736668860' )]"

					state = {
						name = _show
						on_start = "[GetVariableSystem.Set( 'lsq_migrate_installed', 'yes' )]"
					}
				}
			}
		}

		### Construction Manager enabled
		vbox = {
			datamodel = "[ModsGui.LocalMods]"

			item = {
				widget = {
					size = { 0 0 }
					visible_at_creation = no
					visible = "[And( StringContains( LocalMod.Path, '3736668860' ), ModsGui.ActivePlayset.ContainsMod( LocalMod.Id ) )]"

					state = {
						name = _show
						on_start = "[GetVariableSystem.Set( 'lsq_migrate_new_active', 'yes' )]"
					}
				}
			}
		}

		### Enable Construction Manager
		vbox = {
			datamodel = "[ModsGui.LocalMods]"

			item = {
				widget = {
					size = { 0 0 }
					visible_at_creation = no
					visible = "[And3( GetVariableSystem.Exists( 'lsq_migrate_enable' ), StringContains( LocalMod.Path, '3736668860' ), Not( ModsGui.ActivePlayset.ContainsMod( LocalMod.Id ) ) )]"

					state = {
						name = _show
						on_start = "[ModsGui.ActivePlayset.AddMod( LocalMod.Id )]"
						on_start = "[GetVariableSystem.Set( 'lsq_migrate_new_added', 'yes' )]"
						on_start = "[GetVariableSystem.Clear( 'lsq_migrate_enable' )]"
					}
				}
			}
		}

		### Disable this mod once Construction Manager is active.
		vbox = {
			datamodel = "[ModsGui.LocalMods]"

			item = {
				widget = {
					size = { 0 0 }
					visible_at_creation = no
					visible = "[And3( Or( GetVariableSystem.Exists( 'lsq_migrate_new_active' ), GetVariableSystem.Exists( 'lsq_migrate_new_added' ) ), Or( StringContains( LocalMod.Path, '3659626562' ), StringContains( LocalMod.Path, 'eu5_auto_expand_forked' ) ), ModsGui.ActivePlayset.ContainsMod( LocalMod.Id ) )]"

					state = {
						name = _show
						on_start = "[ModsGui.ActivePlayset.RemoveMod( LocalMod.Id )]"
						on_start = "[GetVariableSystem.Set( 'lsq_migrate_apply', 'yes' )]"
					}
				}
			}
		}

		### Apply playset changes after the add and remove settle.
		widget = {
			size = { 0 0 }
			visible_at_creation = no
			visible = "[GetVariableSystem.Exists( 'lsq_migrate_apply' )]"

			state = {
				name = _show
				duration = 0.5
				on_finish = "[ModsGui.DownloadAndApplyChanges]"
				on_finish = "[GetVariableSystem.Clear( 'lsq_migrate_apply' )]"
				on_finish = "[GetVariableSystem.Clear( 'lsq_migrate_new_added' )]"
			}
		}

		### Open the Workshop.
		widget = {
			size = { 0 0 }
			visible_at_creation = no
			visible = "[GetVariableSystem.Exists( 'lsq_migrate_open_workshop' )]"

			state = {
				name = _show
				on_start = "[ModsGui.OpenExternalInterface()]"
				on_start = "[GetVariableSystem.Clear( 'lsq_migrate_open_workshop' )]"
			}
		}
	}
}
